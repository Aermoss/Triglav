#[include "Common/System.zir", "Common/Format.zir" : *]

const SYSTEM_FILE_SYSTEM: u32 = 1;
const SYSTEM_BLOCK_ADDRESSING: u32 = 2;

fn Main(args: &mut Vector<String>) -> i32 {
    let info = GetSystemInformation();
    WriteLine("Clock:    " + String::FromInteger(info.clock_frequency / 1000000) + " MHz");
    WriteLine(Range("Stacks:   ", info.stacks_start, info.stacks_end));
    WriteLine(Range("Kernel:   ", info.kernel_start, info.kernel_end));
    WriteLine(Range("Heap:     ", info.heap_start, info.heap_end));
    WriteLine(Range("Flash:    ", info.flash_start, info.flash_end));

    if (info.flags & SYSTEM_FILE_SYSTEM) != 0 {
        let card = if (info.flags & SYSTEM_BLOCK_ADDRESSING) != 0 { "SDHC" } else { "SDSC" };
        WriteLine("SD card:  " + String::FromInteger(info.sd_sectors / 2048) + " MB, " + (&info.file_system[0] as *i8).ToString() + " with " +
            String::FromInteger(info.cluster_bytes) + " byte clusters, " + card);
    } else {
        WriteLine("SD card:  none");
    }

    0
}
