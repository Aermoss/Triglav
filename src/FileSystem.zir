#[include "src/Volume.zir", "src/FAT32.zir", "src/ExFAT.zir" : *]

const MAX_LIST_ENTRIES: u32 = 65536;
const KIND_FILE: u32 = 1;
const KIND_FOLDER: u32 = 2;
const LIST_ENTRY_SIZE: u32 = FILE_NAME_LENGTH + 8;

static mut file_system_ready: bool = false;
static mut file_system_locked: bool = false;
static mut current_path: [i8; 256];
static mut scratch_path: [i8; 256];
static mut walk_component: [i8; 256];
static mut scratch_name: [i8; 256];
static mut scratch_canonical: [i8; 256];
static mut scratch_parent: FileInfo;
static mut scratch_info: FileInfo;
static mut scratch_other: FileInfo;

fn FileSystemName() -> *i8 {
    if operations == null { "none" } else { operations->name }
}

fn MountFileSystem() -> bool {
    file_system_ready = false;
    (cached_sector, sector_dirty, cached_fat_sector, fat_dirty, io_failed) = (NO_SECTOR, false, NO_SECTOR, false, false);

    if !SDInitialize() {
        return false;
    }

    let mut start: u32 = 0;
    let mut sector = LoadSector(0);

    if sector == null {
        return false;
    }

    if !IsBootSector(sector as *u8) && !IsExFATBootSector(sector as *u8) {
        if sector[510] != 0x55 || sector[511] != 0xAA {
            return false;
        }

        let mut found = false;
        let mut i: u32 = 0;

        while i < 4 && !found {
            let entry = sector + (446 + i * 16) as usize;
            let kind = entry[4];

            if kind == 0x0B || kind == 0x0C || kind == 0x1B || kind == 0x1C || kind == 0x07 {
                start = GetWord(entry as *u8 + 8);
                found = start != 0;
            }

            i += 1;
        }

        if !found {
            return false;
        }

        sector = LoadSector(start);

        if sector == null || (!IsBootSector(sector as *u8) && !IsExFATBootSector(sector as *u8)) {
            return false;
        }
    }

    operations = null;
    let mounted = if IsExFATBootSector(sector as *u8) { ExFATMount(start, sector as *u8) } else { FAT32Mount(start, sector as *u8) };

    if !mounted || io_failed {
        operations = null;
        return false;
    }

    current_path[0] = '/';
    current_path[1] = '\0';
    file_system_ready = true;
    true
}

fn InitializeFileSystem() {
    current_path[0] = '/';
    current_path[1] = '\0';
    MountFileSystem();
}

fn LockFileSystem() {
    loop {
        let interrupts = DisableInterrupts();

        if !file_system_locked {
            file_system_locked = true;
            RestoreInterrupts(interrupts);
            return;
        }

        RestoreInterrupts(interrupts);
        Yield();
    }
}

fn UnlockFileSystem() {
    file_system_locked = false;
}

fn Begin() -> u32 {
    LockFileSystem();
    io_failed = false;

    if !file_system_ready && !MountFileSystem() {
        UnlockFileSystem();
        return FILE_NO_FILE_SYSTEM;
    }

    FILE_OK
}

fn Finish(result: u32) -> u32 {
    let flushed = FlushAll();
    let mut code = result;

    if io_failed || !flushed {
        file_system_ready = false;
        code = FILE_IO_ERROR;
    }

    UnlockFileSystem();
    code
}

fn HasFileSystem() -> bool {
    if Begin() != FILE_OK {
        return false;
    }

    Finish(FILE_OK) == FILE_OK
}

fn FindChild(folder: *FileInfo, name: *i8, info: *mut FileInfo) -> u32 {
    let mut cursor = FolderCursor(folder);

    loop {
        let result = NextFile(&mut cursor, info);

        if result != FILE_OK {
            return result;
        }

        if SameName(&info->name[0] as *i8, name) || SameName(&short_display[0] as *i8, name) {
            return FILE_OK;
        }
    }

    FILE_NOT_FOUND
}

fn AppendComponents(text: *i8, output: *mut i8, length: *mut u32) -> bool {
    let mut i: u32 = 0;

    loop {
        while text[i as usize] == '/' {
            i += 1;
        }

        if text[i as usize] == '\0' {
            return true;
        }

        let start = i;

        while text[i as usize] != '/' && text[i as usize] != '\0' {
            i += 1;
        }

        let size = i - start;

        if size == 1 && text[start as usize] == '.' {
            continue;
        }

        if size == 2 && text[start as usize] == '.' && text[(start + 1) as usize] == '.' {
            while *length > 0 && output[(*length - 1) as usize] != '/' {
                *length -= 1;
            }

            if *length > 0 {
                *length -= 1;
            }

            continue;
        }

        if *length + size + 2 > MAX_PATH {
            return false;
        }

        output[*length as usize] = '/';
        *length += 1;
        let mut k: u32 = 0;

        while k < size {
            output[(*length + k) as usize] = text[(start + k) as usize];
            k += 1;
        }

        *length += size;
    }

    true
}

fn NormalizePath(path: *i8, output: *mut i8) -> bool {
    let mut length: u32 = 0;

    if path[0] != '/' && !AppendComponents(&current_path[0] as *i8, output, &mut length) {
        return false;
    }

    if !AppendComponents(path, output, &mut length) {
        return false;
    }

    if length == 0 {
        output[0] = '/';
        length = 1;
    }

    output[length as usize] = '\0';
    true
}

fn AppendName(path: *mut i8, length: *mut u32, name: *i8) -> bool {
    let size = StringLength(name);

    if *length + size + 2 > MAX_PATH {
        return false;
    }

    path[*length as usize] = '/';
    *length += 1;
    let mut i: u32 = 0;

    while i < size {
        path[(*length + i) as usize] = name[i as usize];
        i += 1;
    }

    *length += size;
    path[*length as usize] = '\0';
    true
}

fn WalkPath(normalized: *i8, info: *mut FileInfo, canonical: *mut i8) -> u32 {
    RootInfo(info);
    let mut canonical_length: u32 = 0;
    let mut i: u32 = 1;

    while normalized[i as usize] != '\0' {
        let start = i;

        while normalized[i as usize] != '/' && normalized[i as usize] != '\0' {
            walk_component[(i - start) as usize] = normalized[i as usize];
            i += 1;
        }

        walk_component[(i - start) as usize] = '\0';

        if normalized[i as usize] == '/' {
            i += 1;
        }

        if !IsFolder(info as *FileInfo) {
            return FILE_NOT_FOUND;
        }

        let result = FindChild(info as *FileInfo, &walk_component[0] as *i8, info);

        if result != FILE_OK {
            return result;
        }

        if canonical != null && !AppendName(canonical, &mut canonical_length, &info->name[0] as *i8) {
            return FILE_BAD_NAME;
        }
    }

    if canonical != null && canonical_length == 0 {
        canonical[0] = '/';
        canonical[1] = '\0';
    }

    FILE_OK
}

fn Lookup(path: *i8, info: *mut FileInfo, canonical: *mut i8) -> u32 {
    if !NormalizePath(path, &mut scratch_path[0]) {
        return FILE_BAD_NAME;
    }

    WalkPath(&scratch_path[0] as *i8, info, canonical)
}

fn LookupParent(path: *i8, parent: *mut FileInfo, name: *mut i8, canonical: *mut i8) -> u32 {
    if !NormalizePath(path, &mut scratch_path[0]) {
        return FILE_BAD_NAME;
    }

    let length = StringLength(&scratch_path[0] as *i8);

    if length <= 1 {
        return FILE_BAD_NAME;
    }

    let mut split = length;

    while split > 0 && scratch_path[(split - 1) as usize] != '/' {
        split -= 1;
    }

    CopyText(name, &scratch_path[split as usize] as *i8, FILE_NAME_LENGTH);

    if split == 1 {
        scratch_path[1] = '\0';
    } else {
        scratch_path[(split - 1) as usize] = '\0';
    }

    let result = WalkPath(&scratch_path[0] as *i8, parent, canonical);

    if result != FILE_OK {
        return result;
    }

    if !IsFolder(parent as *FileInfo) { FILE_NOT_FOUND } else { FILE_OK }
}

fn IsEmptyFolder(folder: *FileInfo) -> bool {
    let mut cursor = FolderCursor(folder);
    NextFile(&mut cursor, &mut scratch_other) == FILE_NOT_FOUND && !io_failed
}

fn IsPathInside(path: *i8, ancestor: *i8) -> bool {
    let (mut i, mut j): (usize, usize) = (0, 0);

    while ancestor[j] != '\0' {
        if path[i] == '\0' || NextCode(path, &mut i) != NextCode(ancestor, &mut j) {
            return false;
        }
    }

    path[i] == '\0' || path[i] == '/' || (j == 1 && ancestor[0] == '/')
}

fn FindFile(path: *i8, info: *mut FileInfo) -> u32 {
    let start = Begin();

    if start != FILE_OK {
        return start;
    }

    Finish(Lookup(path, info, null))
}

fn ReadFileRange(info: *mut FileInfo, offset: u32, buffer: *mut u8, count: u32) -> u32 {
    if Begin() != FILE_OK {
        return 0;
    }

    let length = ReadData(info, offset, buffer, count);
    if Finish(FILE_OK) == FILE_OK { length } else { 0 }
}

fn GetPathKind(path: *i8) -> u32 {
    if Begin() != FILE_OK {
        return 0;
    }

    let found = Lookup(path, &mut scratch_info, null) == FILE_OK;
    let kind = if !found { 0 } else if IsFolder(&scratch_info) { KIND_FOLDER } else { KIND_FILE };
    if Finish(FILE_OK) == FILE_OK { kind } else { 0 }
}

fn GetCanonicalPath(path: *i8, buffer: *mut i8, capacity: usize) -> u32 {
    let start = Begin();

    if start != FILE_OK {
        return start;
    }

    let mut result = Lookup(path, &mut scratch_info, &mut scratch_canonical[0]);

    if result == FILE_OK && !CopyText(buffer, &scratch_canonical[0] as *i8, capacity as u32) {
        result = FILE_BAD_NAME;
    }

    Finish(result)
}

fn ReadWholeFile(path: *i8, buffer: *mut u8, capacity: usize, size: *mut usize) -> u32 {
    let start = Begin();

    if start != FILE_OK {
        return start;
    }

    let mut result = Lookup(path, &mut scratch_info, null);

    if result == FILE_OK && IsFolder(&scratch_info) {
        result = FILE_IS_FOLDER;
    }

    if result == FILE_OK {
        *size = scratch_info.size as usize;

        if buffer != null && capacity < *size {
            result = FILE_NO_SPACE;
        } else if buffer != null && ReadData(&mut scratch_info, 0, buffer, scratch_info.size) != scratch_info.size {
            result = FILE_IO_ERROR;
        }
    }

    Finish(result)
}

fn WriteInto(folder: *mut FileInfo, name: *i8, data: *u8, size: u32) -> u32 {
    let mut exists = false;
    let found = FindChild(folder, name, &mut scratch_other);

    if found == FILE_OK {
        if IsFolder(&scratch_other) {
            return FILE_IS_FOLDER;
        }

        exists = true;
    } else if found != FILE_NOT_FOUND {
        return found;
    } else if !IsValidName(name) {
        return FILE_BAD_NAME;
    }

    let (old_cluster, old_flags, old_length) = if exists { (scratch_other.first_cluster, scratch_other.flags, scratch_other.data_length) } else { (0u32, 0u32, 0u32) };
    let mut first: u32 = 0;
    let result = WriteChain(data, size, &mut first);

    if result != FILE_OK {
        return result;
    }

    if exists {
        let update = UpdateEntry(&scratch_other, first, size);

        if update != FILE_OK {
            return update;
        }

        if !ReleaseClusters(old_cluster, old_flags, old_length) {
            return FILE_IO_ERROR;
        }

        return FILE_OK;
    }

    let created = CreateEntry(folder, name, ATTRIBUTE_ARCHIVE, first, size, 0, size, &mut scratch_other);

    if created != FILE_OK && first != 0 {
        FreeChain(first);
    }

    created
}

fn WriteFile(path: *i8, data: *u8, size: u32) -> u32 {
    let start = Begin();

    if start != FILE_OK {
        return start;
    }

    let mut result = LookupParent(path, &mut scratch_parent, &mut scratch_name[0], null);

    if result == FILE_OK {
        CopyText(&mut scratch_canonical[0], &scratch_name[0] as *i8, FILE_NAME_LENGTH);
        result = WriteInto(&mut scratch_parent, &scratch_canonical[0] as *i8, data, size);
    }

    Finish(result)
}

fn PrepareWrite(path: *i8, canonical: *mut i8, info: *mut FileInfo, exists: *mut bool) -> u32 {
    let start = Begin();

    if start != FILE_OK {
        return start;
    }

    *exists = false;
    let mut result = LookupParent(path, &mut scratch_parent, &mut scratch_name[0], canonical);

    if result == FILE_OK {
        let found = FindChild(&scratch_parent, &scratch_name[0] as *i8, info);

        if found == FILE_OK {
            if IsFolder(info as *FileInfo) {
                result = FILE_IS_FOLDER;
            } else {
                *exists = true;
            }
        } else if found != FILE_NOT_FOUND {
            result = found;
        } else if !IsValidName(&scratch_name[0] as *i8) {
            result = FILE_BAD_NAME;
        } else {
            CopyText(&mut info->name[0], &scratch_name[0] as *i8, FILE_NAME_LENGTH);
        }

        if result == FILE_OK {
            let mut length = StringLength(canonical as *i8);

            if length == 1 {
                length = 0;
            }

            if !AppendName(canonical, &mut length, &info->name[0] as *i8) {
                result = FILE_BAD_NAME;
            }
        }
    }

    Finish(result)
}

fn CreateFolder(path: *i8) -> u32 {
    let start = Begin();

    if start != FILE_OK {
        return start;
    }

    let mut result = LookupParent(path, &mut scratch_parent, &mut scratch_name[0], null);

    if result == FILE_OK {
        let found = FindChild(&scratch_parent, &scratch_name[0] as *i8, &mut scratch_other);

        if found == FILE_OK {
            result = FILE_EXISTS;
        } else if found != FILE_NOT_FOUND {
            result = found;
        } else if !IsValidName(&scratch_name[0] as *i8) {
            result = FILE_BAD_NAME;
        } else {
            let cluster = AllocateCluster(0, true);

            if cluster == 0 {
                result = if io_failed { FILE_IO_ERROR } else { FILE_NO_SPACE };
            } else {
                if !operations->prepare_folder(cluster, &scratch_parent) {
                    result = FILE_IO_ERROR;
                }

                CopyText(&mut scratch_canonical[0], &scratch_name[0] as *i8, FILE_NAME_LENGTH);

                if result == FILE_OK {
                    result = CreateEntry(&mut scratch_parent, &scratch_canonical[0] as *i8, ATTRIBUTE_FOLDER, cluster, 0, 0, cluster_bytes, &mut scratch_other);
                }

                if result != FILE_OK {
                    FreeChain(cluster);
                }
            }
        }
    }

    Finish(result)
}

fn RemoveFound(info: *FileInfo, canonical: *i8) -> u32 {
    if IsFolder(info) && !IsEmptyFolder(info) {
        return if io_failed { FILE_IO_ERROR } else { FILE_NOT_EMPTY };
    }

    let result = DeleteEntry(info);

    if result != FILE_OK {
        return result;
    }

    if !ReleaseClusters(info->first_cluster, info->flags, info->data_length) {
        return FILE_IO_ERROR;
    }

    if IsFolder(info) && IsPathInside(&current_path[0] as *i8, canonical) {
        let mut length = StringLength(canonical);

        while length > 1 && canonical[(length - 1) as usize] != '/' {
            length -= 1;
        }

        let keep = if length > 1 { length - 1 } else { 1 };
        let mut i: u32 = 0;

        while i < keep {
            current_path[i as usize] = canonical[i as usize];
            i += 1;
        }

        current_path[keep as usize] = '\0';
    }

    FILE_OK
}

fn RemoveWith(path: *i8, files: bool, folders: bool) -> u32 {
    let start = Begin();

    if start != FILE_OK {
        return start;
    }

    let mut result = Lookup(path, &mut scratch_info, &mut scratch_canonical[0]);

    if result == FILE_OK && scratch_info.entry_cluster == 0 {
        result = FILE_NOT_FOUND;
    } else if result == FILE_OK && IsFolder(&scratch_info) && !folders {
        result = FILE_IS_FOLDER;
    } else if result == FILE_OK && !IsFolder(&scratch_info) && !files {
        result = FILE_NOT_FOLDER;
    } else if result == FILE_OK {
        result = RemoveFound(&scratch_info, &scratch_canonical[0] as *i8);
    }

    Finish(result)
}

fn RemoveFile(path: *i8) -> u32 {
    RemoveWith(path, true, false)
}

fn RemoveFolder(path: *i8) -> u32 {
    RemoveWith(path, false, true)
}

fn RemovePath(path: *i8) -> u32 {
    RemoveWith(path, true, true)
}

fn ListFolder(path: *i8, buffer: *mut u8, capacity: u32, count: *mut u32) -> u32 {
    let start = Begin();

    if start != FILE_OK {
        return start;
    }

    let mut result = Lookup(path, &mut scratch_info, null);

    if result == FILE_OK && !IsFolder(&scratch_info) {
        result = FILE_NOT_FOLDER;
    }

    let mut found: u32 = 0;

    if result == FILE_OK {
        let mut cursor = FolderCursor(&scratch_info);

        loop {
            let next = NextFile(&mut cursor, &mut scratch_other);

            if next != FILE_OK {
                if next != FILE_NOT_FOUND {
                    result = next;
                }

                break;
            }

            if buffer != null && found < capacity {
                let record = buffer + (found * LIST_ENTRY_SIZE) as usize;
                CopyText(record as *mut i8, &scratch_other.name[0] as *i8, FILE_NAME_LENGTH);
                let fields = (record + FILE_NAME_LENGTH as usize) as *mut u32;
                fields[0] = if IsFolder(&scratch_other) { KIND_FOLDER } else { KIND_FILE };
                fields[1] = scratch_other.size;
            }

            found += 1;
        }
    }

    *count = found;

    if result == FILE_OK && buffer != null && found > capacity {
        result = FILE_NO_SPACE;
    }

    Finish(result)
}

fn MoveEntry(source: *i8, destination: *i8, into_folder: bool) -> u32 {
    let start = Begin();

    if start != FILE_OK {
        return start;
    }

    let mut result = Lookup(source, &mut scratch_info, &mut scratch_canonical[0]);

    if result == FILE_OK && scratch_info.entry_cluster == 0 {
        result = FILE_NOT_FOUND;
    }

    if result != FILE_OK {
        return Finish(result);
    }

    let is_folder = IsFolder(&scratch_info);
    let mut target: [i8; 256];
    let mut name: [i8; 256];
    let mut moved = false;

    if into_folder && Lookup(destination, &mut scratch_parent, &mut target[0]) == FILE_OK && IsFolder(&scratch_parent) {
        CopyText(&mut name[0], &scratch_info.name[0] as *i8, FILE_NAME_LENGTH);
        moved = true;
    }

    if !moved {
        result = LookupParent(destination, &mut scratch_parent, &mut name[0], &mut target[0]);
    }

    if result == FILE_OK && !IsValidName(&name[0] as *i8) {
        result = FILE_BAD_NAME;
    }

    if result == FILE_OK && is_folder && IsPathInside(&target[0] as *i8, &scratch_canonical[0] as *i8) {
        result = FILE_INTO_ITSELF;
    }

    if result == FILE_OK {
        let found = FindChild(&scratch_parent, &name[0] as *i8, &mut scratch_other);
        let same = found == FILE_OK && scratch_other.entry_cluster == scratch_info.entry_cluster && scratch_other.entry_index == scratch_info.entry_index;

        if found == FILE_OK && !same {
            if is_folder || IsFolder(&scratch_other) {
                result = FILE_EXISTS;
            } else {
                result = DeleteEntry(&scratch_other);

                if result == FILE_OK && !ReleaseClusters(scratch_other.first_cluster, scratch_other.flags, scratch_other.data_length) {
                    result = FILE_IO_ERROR;
                }
            }
        } else if found != FILE_OK && found != FILE_NOT_FOUND {
            result = found;
        }

        if result == FILE_OK {
            let parent_cluster = FolderCluster(&scratch_parent);
            result = CreateEntry(&mut scratch_parent, &name[0] as *i8, scratch_info.attributes, scratch_info.first_cluster, scratch_info.size, scratch_info.flags, scratch_info.data_length, &mut scratch_other);

            if result == FILE_OK {
                result = DeleteEntry(&scratch_info);
            }

            if result == FILE_OK && is_folder {
                result = SetParentEntry(&scratch_info, parent_cluster);
            }

            if result == FILE_OK && is_folder && IsPathInside(&current_path[0] as *i8, &scratch_canonical[0] as *i8) {
                let mut length = StringLength(&target[0] as *i8);

                if length == 1 {
                    length = 0;
                }

                AppendName(&mut target[0], &mut length, &name[0] as *i8);
                let rest = &current_path[StringLength(&scratch_canonical[0] as *i8) as usize] as *i8;
                let mut combined: [i8; 256];
                let mut combined_length: u32 = 0;

                if CopyText(&mut combined[0], &target[0] as *i8, MAX_PATH) {
                    combined_length = StringLength(&combined[0] as *i8);
                }

                let mut i: u32 = 0;

                while rest[i as usize] != '\0' && combined_length + i + 1 < MAX_PATH {
                    combined[(combined_length + i) as usize] = rest[i as usize];
                    i += 1;
                }

                combined[(combined_length + i) as usize] = '\0';
                CopyText(&mut current_path[0], &combined[0] as *i8, MAX_PATH);
            }
        }
    }

    Finish(result)
}

fn MovePath(source: *i8, destination: *i8) -> u32 {
    MoveEntry(source, destination, true)
}

fn RenamePath(source: *i8, destination: *i8) -> u32 {
    MoveEntry(source, destination, false)
}

fn CopyFile(source: *i8, destination: *i8) -> u32 {
    let start = Begin();

    if start != FILE_OK {
        return start;
    }

    let mut result = Lookup(source, &mut scratch_info, null);

    if result == FILE_OK && IsFolder(&scratch_info) {
        result = FILE_IS_FOLDER;
    }

    if result != FILE_OK {
        return Finish(result);
    }

    let size = scratch_info.size;
    let data = Allocate(if size == 0 { 1 } else { size });

    if data == null {
        return Finish(FILE_NO_MEMORY);
    }

    if ReadData(&mut scratch_info, 0, data, size) != size {
        result = FILE_IO_ERROR;
    }

    let mut name: [i8; 256];

    if result == FILE_OK {
        if Lookup(destination, &mut scratch_parent, null) == FILE_OK && IsFolder(&scratch_parent) {
            CopyText(&mut name[0], &scratch_info.name[0] as *i8, FILE_NAME_LENGTH);
        } else {
            result = LookupParent(destination, &mut scratch_parent, &mut name[0], null);
        }
    }

    if result == FILE_OK {
        result = WriteInto(&mut scratch_parent, &name[0] as *i8, data as *u8, size);
    }

    Free(data);
    Finish(result)
}

fn ChangeFolder(path: *i8) -> u32 {
    let start = Begin();

    if start != FILE_OK {
        return start;
    }

    let mut result = Lookup(path, &mut scratch_info, &mut scratch_canonical[0]);

    if result == FILE_OK && !IsFolder(&scratch_info) {
        result = FILE_NOT_FOLDER;
    }

    if result == FILE_OK {
        CopyText(&mut current_path[0], &scratch_canonical[0] as *i8, MAX_PATH);
    }

    Finish(result)
}

fn CurrentFolder() -> *i8 {
    &current_path[0] as *i8
}

fn FileSystemStatistics(total: *mut u32, free: *mut u32, bytes: *mut u32) -> u32 {
    let start = Begin();

    if start != FILE_OK {
        return start;
    }

    if free_clusters == UNKNOWN_COUNT {
        let counted = CountFreeClusters();

        if !io_failed {
            (free_clusters, information_dirty) = (counted, true);
        }
    }

    (*total, *free, *bytes) = (cluster_count, free_clusters, cluster_bytes);
    Finish(FILE_OK)
}

fn FileErrorMessage(error: u32) -> *i8 {
    if error == FILE_NO_FILE_SYSTEM {
        "There is no SD card with a FAT32 or exFAT file system."
    } else if error == FILE_NOT_FOUND {
        "There is no such file or folder."
    } else if error == FILE_BAD_NAME {
        "That name is not allowed."
    } else if error == FILE_NO_SHORT_NAME {
        "There is no free short name in that folder."
    } else if error == FILE_NO_SPACE {
        "There is not enough free space."
    } else if error == FILE_IO_ERROR {
        "The SD card did not answer."
    } else if error == FILE_NOT_FOLDER {
        "That is not a folder."
    } else if error == FILE_IS_FOLDER {
        "That is a folder."
    } else if error == FILE_NOT_EMPTY {
        "The folder is not empty."
    } else if error == FILE_EXISTS {
        "There is already something with that name."
    } else if error == FILE_INTO_ITSELF {
        "A folder cannot go into itself."
    } else if error == FILE_NO_MEMORY {
        "There is not enough memory."
    } else if error == FILE_BAD_HANDLE {
        "That is not an open file."
    } else if error == FILE_BUSY {
        "The file is already open for writing."
    } else if error == FILE_NOT_ALLOWED {
        "The file was not opened for that."
    } else if error == FILE_TOO_MANY {
        "There are too many open files."
    } else if error == FILE_BAD_POSITION {
        "That position is before the start of the file."
    } else if error == FILE_NOT_EXECUTABLE {
        "That is not a valid executable."
    } else if error == FILE_NO_PROCESS {
        "There is no room for another process."
    } else if error == FILE_CRASHED {
        "The process crashed."
    } else if error == FILE_KILLED {
        "The process was killed."
    } else if error == FILE_TOO_LONG {
        "The command line is too long."
    } else {
        "The operation succeeded."
    }
}
