#[include "Common/System.zir" : *]

const SYSTEM_DISK_STATISTICS: u32 = 30;

struct DiskStatistics {
    pub total: u32,
    pub free: u32,
    pub bytes: u32
}

fn GetDiskStatistics(statistics: &mut DiskStatistics) -> u32 {
    let mut result: u32 = 0;

    volatile asm : a7(SYSTEM_DISK_STATISTICS), a0(statistics as *mut DiskStatistics) -> {
        ecall
    } -> a0(result) : memory;

    result
}

fn Main(args: &mut Vector<String>) -> i32 {
    let mut statistics: DiskStatistics;
    let error = GetDiskStatistics(statistics);

    if error != FILE_OK {
        WriteLine(ErrorMessage(error));
        return 1;
    }

    let (total, free, bytes) = (statistics.total, statistics.free, statistics.bytes);
    let sectors = bytes / 512;
    WriteLine("Clusters: " + String::FromInteger(total - free) + " of " + String::FromInteger(total) + " used, " + String::FromInteger(bytes) + " bytes each");
    WriteLine("Used:     " + String::FromInteger((total - free) * sectors / 2) + " KB");
    WriteLine("Free:     " + String::FromInteger(free * sectors / 2) + " KB");
    0
}
