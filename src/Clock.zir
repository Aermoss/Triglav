#[include "src/Devices.zir", "src/Console.zir", "src/Strings.zir", "src/ESP.zir", "src/WiFi.zir" : *]

const NTP_PORT: u32 = 123;
const NTP_PACKET_SIZE: u32 = 48;
const NTP_UNIX_OFFSET: u32 = 2208988800;
const SECONDS_PER_DAY: u32 = 86400;

static mut clock_valid: bool = false;
static mut clock_seconds: u32 = 0;
static mut clock_start: u32 = 0;
static mut clock_zone: i32 = 3;
static mut ntp_packet: [u8; 48];

fn ClockNow() -> u32 {
    clock_seconds + (GetTime() - clock_start) / 1000
}

fn PacketWord(offset: usize) -> u32 {
    (ntp_packet[offset] as u32 << 24) | (ntp_packet[offset + 1] as u32 << 16) | (ntp_packet[offset + 2] as u32 << 8) | ntp_packet[offset + 3] as u32
}

fn ClockSync() -> bool {
    if !ESPReady() {
        return false;
    }

    ESPCommand("ATE0", 1000);
    ESPClose();

    if ESPOpen("UDP", "pool.ntp.org", NTP_PORT) != ESPResult::Ok {
        WriteLine("the time server could not be reached, is WiFi connected?");
        return false;
    }

    for i in 0..NTP_PACKET_SIZE {
        ntp_packet[i as usize] = 0;
    }

    ntp_packet[0] = 0x1B;
    let sent = GetTime();

    if !ESPSend(&ntp_packet[0], NTP_PACKET_SIZE) {
        ESPClose();
        WriteLine("the time request could not be sent");
        return false;
    }

    let length = ESPReceive(&mut ntp_packet[0], NTP_PACKET_SIZE, 5000);
    let received = GetTime();
    ESPClose();
    let seconds = PacketWord(40);

    if length != NTP_PACKET_SIZE || seconds < NTP_UNIX_OFFSET {
        WriteLine("the time server did not answer");
        return false;
    }

    let fraction = ((PacketWord(44) >> 16) * 1000u32) >> 16;
    clock_seconds = seconds - NTP_UNIX_OFFSET;
    clock_start = received - fraction - (received - sent) / 2;
    clock_valid = true;
    true
}

fn WriteTwoDigits(value: u32) {
    if value < 10 {
        WriteCharacter('0');
    }

    WriteInteger(value);
}

fn DayName(day: u32) -> *i8 {
    match day {
        0 => "Sun",
        1 => "Mon",
        2 => "Tue",
        3 => "Wed",
        4 => "Thu",
        5 => "Fri",
        _ => "Sat"
    }
}

fn WriteClock() {
    let now = ClockNow();
    let zone_seconds = (if clock_zone < 0 { 0 - clock_zone } else { clock_zone }) as u32 * 3600;
    let local = if clock_zone < 0 { now - zone_seconds } else { now + zone_seconds };
    let days = local / SECONDS_PER_DAY;
    let rest = local % SECONDS_PER_DAY;

    let shifted = days + 719468;
    let era = shifted / 146097;
    let day_of_era = shifted - era * 146097;
    let year_of_era = (day_of_era - day_of_era / 1460 + day_of_era / 36524 - day_of_era / 146096) / 365;
    let day_of_year = day_of_era - (365 * year_of_era + year_of_era / 4 - year_of_era / 100);
    let month_index = (5 * day_of_year + 2) / 153;
    let day = day_of_year - (153 * month_index + 2) / 5 + 1;
    let month = if month_index < 10 { month_index + 3 } else { month_index - 9 };
    let year = year_of_era + era * 400 + (if month <= 2 { 1 } else { 0 });

    Write(DayName((days + 4) % 7));
    WriteCharacter(' ');
    WriteInteger(year);
    WriteCharacter('-');
    WriteTwoDigits(month);
    WriteCharacter('-');
    WriteTwoDigits(day);
    WriteCharacter(' ');
    WriteTwoDigits(rest / 3600);
    WriteCharacter(':');
    WriteTwoDigits(rest / 60 % 60);
    WriteCharacter(':');
    WriteTwoDigits(rest % 60);
    Write(" UTC");
    WriteCharacter(if clock_zone < 0 { '-' } else { '+' });
    WriteInteger((if clock_zone < 0 { 0 - clock_zone } else { clock_zone }) as u32);
    WriteCharacter('\n');
}

fn CommandDate(arguments: *i8) {
    let mut rest = arguments;

    if ParseCommand(arguments, "sync", &mut rest) {
        if ClockSync() {
            WriteClock();
        }
    } else if ParseCommand(arguments, "zone", &mut rest) {
        let text = SkipSpaces(rest);
        let mut zone = 0;
        let end = ParseSignedField(if *text == '+' { text + 1 } else { text }, &mut zone);

        if end == null || !AtEnd(end) || zone < -12 || zone > 14 {
            WriteLine("usage: date zone <hours from UTC, -12 to +14>");
            return;
        }

        clock_zone = zone;

        if clock_valid {
            WriteClock();
        }
    } else if AtEnd(arguments) {
        if clock_valid {
            WriteClock();
        } else {
            WriteLine("the time is not set, run date sync");
        }
    } else {
        WriteLine("usage: date [sync | zone <hours>]");
    }
}
