#[include "src/Devices.zir", "src/Trap.zir", "src/Memory.zir", "src/Console.zir", "src/FileSystem.zir", "src/Handles.zir", "src/Paging.zir",
    "src/Process.zir", "src/Executable.zir", "src/Services.zir" : *]

const INTERRUPT_TIMER: u32 = 1;
const INTERRUPT_UART: u32 = 2;
const INTERRUPT_SOFTWARE: u32 = 4;

enum TrapCause: u32 {
    InstructionFault = 0x00000001,
    IllegalInstruction = 0x00000002,
    Breakpoint = 0x00000003,
    LoadFault = 0x00000005,
    StoreFault = 0x00000007,
    SystemCall = 0x00000008,
    Timer = 0x80000000,
    UART = 0x80000001,
    Software = 0x80000002,
    Unknown = 0xFFFFFFFF
}

enum SystemCall: u32 {
    Exit = 0,
    Allocate = 1,
    Free = 2,
    ConsoleRead = 3,
    ConsoleWrite = 4,
    PathKind = 5,
    CanonicalPath = 6,
    ReadFile = 7,
    WriteFile = 8,
    RemoveFile = 9,
    Sleep = 10,
    CommandLine = 11,
    Open = 12,
    Close = 13,
    Read = 14,
    Write = 15,
    Seek = 16,
    Size = 17,
    ListFolder = 18,
    CreateFolder = 19,
    RemoveFolder = 20,
    ChangeFolder = 21,
    Rename = 22,
    Move = 23,
    Copy = 24,
    Execute = 25,
    Spawn = 26,
    Kill = 27,
    ListProcesses = 28,
    SystemInformation = 29,
    DiskStatistics = 30,
    HeapStatistics = 31,
    DebugPeek = 32,
    DebugPoke = 33,
    DebugRead = 34,
    SetAnimation = 35,
    SetLEDs = 36,
    ThreadCreate = 37,
    ThreadExit = 38,
    Yield = 39,
    FutexWait = 40,
    FutexWake = 41,
    ProcessorCount = 42,
    ConsolePending = 43,
    Unknown = 0xFFFFFFFF
}

const TICK_CYCLES: u32 = CLK_FREQ / TICK_RATE;
const USER_STRING_LIMIT: u32 = 4096;

static mut next_ticks: [u32; 8];

fn InitializeInterrupts() {
    let core = ReadCoreID();
    InitializeTraps();
    next_ticks[core as usize] = GetCycles() + TICK_CYCLES;
    SetTimer(next_ticks[core as usize]);
    SetInterruptMask(if core == 0 { INTERRUPT_TIMER | INTERRUPT_UART | INTERRUPT_SOFTWARE } else { INTERRUPT_TIMER | INTERRUPT_SOFTWARE });
    EnableInterrupts();
}

fn FaultName(cause: TrapCause) -> *i8 {
    match cause {
        TrapCause::InstructionFault => "instruction fetch fault",
        TrapCause::IllegalInstruction => "illegal instruction",
        TrapCause::Breakpoint => "breakpoint",
        TrapCause::LoadFault => "load fault",
        TrapCause::StoreFault => "store fault",
        _ => "unknown trap"
    }
}

fn WriteFault(cause: TrapCause, frame: *Frame) {
    Write(FaultName(cause));

    if cause == TrapCause::IllegalInstruction {
        Write(" ");
        WriteHexadecimal(GetBadAddress());
    } else if cause != TrapCause::Breakpoint {
        Write(" at ");
        WriteHexadecimal(GetBadAddress());
    }

    Write(" (pc ");
    WriteHexadecimal(frame->epc);
    WriteLine(").");
}

fn TerminateProcess(frame: *mut Frame) -> *mut Frame {
    EndGroup(CurrentProcess(), FILE_CRASHED, 0, false);
    Schedule(frame)
}

fn InterruptForeground(frame: *mut Frame) -> *mut Frame {
    let foreground = ForegroundProcesses();
    let mut id: u32 = 1;

    while id < MAX_PROCESSES {
        if (foreground & (1u32 << id)) != 0 && processes[id as usize].state != ProcessState::Free {
            EndGroup(id, FILE_KILLED, 0, false);
        }

        id += 1;
    }

    Schedule(frame)
}

fn RejectCall(frame: *mut Frame) -> *mut Frame {
    Write(processes[CurrentProcess() as usize].name);
    Write(" crashed: invalid pointer passed to system call ");
    WriteInteger(frame->a7);
    WriteLine(".");
    TerminateProcess(frame)
}

fn UserRoot() -> u32 {
    processes[CurrentProcess() as usize].page_table
}

fn UserBuffer(address: u32, length: u32, write: bool) -> bool {
    !IsUserProcess(CurrentProcess()) || IsUserRange(UserRoot(), address, length, write)
}

fn UserBufferOrNull(address: u32, length: u32, write: bool) -> bool {
    address == 0 || UserBuffer(address, length, write)
}

fn UserWord(address: u32) -> bool {
    UserBuffer(address, 4, true)
}

fn UserString(address: u32) -> bool {
    !IsUserProcess(CurrentProcess()) || IsUserString(UserRoot(), address, USER_STRING_LIMIT)
}

fn UserStringOrNull(address: u32) -> bool {
    address == 0 || UserString(address)
}

fn ValidateCall(call: SystemCall, frame: *Frame) -> bool {
    let (a0, a1, a2, a3) = (frame->a0, frame->a1, frame->a2, frame->a3);

    match call {
        SystemCall::ConsoleRead => a0 == 0 || a1 == 0 || UserBuffer(a0, 1, true),
        SystemCall::ConsoleWrite => UserBuffer(a0, a1, false),
        SystemCall::PathKind | SystemCall::RemoveFile | SystemCall::CreateFolder | SystemCall::RemoveFolder => UserString(a0),
        SystemCall::CanonicalPath => UserString(a0) && UserBuffer(a1, a2, true),
        SystemCall::ReadFile => UserString(a0) && UserBufferOrNull(a1, a2, true) && UserWord(a3),
        SystemCall::WriteFile => UserString(a0) && UserBuffer(a1, a2, false),
        SystemCall::CommandLine => UserBufferOrNull(a0, a1, true),
        SystemCall::Open => UserString(a0) && UserWord(a2),
        SystemCall::Read => UserBuffer(a1, a2, true) && UserWord(a3),
        SystemCall::Write => UserBuffer(a1, a2, false),
        SystemCall::Seek => UserWord(a3),
        SystemCall::Size => UserWord(a1),
        SystemCall::ListFolder => UserString(a0) && a2 <= MAX_LIST_ENTRIES && UserBufferOrNull(a1, a2 * LIST_ENTRY_SIZE, true) && UserWord(a3),
        SystemCall::Rename => UserString(a0) && UserString(a1),
        SystemCall::Execute => UserString(a0) && UserStringOrNull(a1) && UserBufferOrNull(a2, 4, true),
        SystemCall::Spawn => UserString(a0) && UserStringOrNull(a1) && UserWord(a2),
        SystemCall::ChangeFolder => UserString(a0),
        SystemCall::ListProcesses => a1 <= MAX_PROCESSES && UserBufferOrNull(a0, a1 * size_of<ProcessRecord>() as u32, true) && UserWord(a2),
        SystemCall::SystemInformation => UserBuffer(a0, size_of<SystemInformation>() as u32, true),
        SystemCall::DiskStatistics => UserBuffer(a0, size_of<DiskStatistics>() as u32, true),
        SystemCall::HeapStatistics => UserBuffer(a0, size_of<HeapStatistics>() as u32, true),
        SystemCall::DebugPeek => UserWord(a1),
        SystemCall::DebugRead => UserBuffer(a1, a2, true),
        SystemCall::Move | SystemCall::Copy => UserString(a0) && UserString(a1),
        SystemCall::FutexWait => (a0 & 3) == 0 && UserBuffer(a0, 4, false),
        _ => true
    }
}

@nomangle
fn HandleTrap(cause: TrapCause, frame: *mut Frame) -> *mut Frame {
    AcquireKernel();
    let current = CurrentProcess();

    if processes[current as usize].kill_pending {
        ReleaseMember(current);
        return Schedule(frame);
    }

    match cause {
        TrapCause::Timer => {
            let core = ReadCoreID();
            next_ticks[core as usize] += TICK_CYCLES;
            SetTimer(next_ticks[core as usize]);
            processes[current as usize].ticks += 1;

            if core == 0 {
                ticks += 1;
                WakeSleepingProcesses();
            }

            return Schedule(frame);
        },
        TrapCause::Software => {
            ClearInterrupt();
            return Schedule(frame);
        },
        TrapCause::UART => {
            let character = ReceiveCharacter();

            if character == INTERRUPT_KEY && ForegroundProcesses() != 0 {
                return InterruptForeground(frame);
            }

            StoreCharacter(character);
            let woken = WakeWaitingProcesses();

            if woken != NO_PROCESS {
                return SwitchTo(frame, woken);
            }
        },
        TrapCause::InstructionFault | TrapCause::IllegalInstruction | TrapCause::Breakpoint | TrapCause::LoadFault | TrapCause::StoreFault => {
            if (frame->status & STATUS_PREVIOUS_USER) == 0 {
                Write("Kernel ");
                WriteFault(cause, frame);
                loop {}
            }

            Write(processes[CurrentProcess() as usize].name);
            Write(" crashed: ");
            WriteFault(cause, frame);
            return TerminateProcess(frame);
        },
        TrapCause::SystemCall => {
            let call = frame->a7 as SystemCall;

            if !ValidateCall(call, frame) {
                return RejectCall(frame);
            }

            match call {
                SystemCall::Exit => {
                    EndGroup(CurrentProcess(), FILE_OK, frame->a0 as i32, true);
                    return Schedule(frame);
                },
                SystemCall::Allocate => {
                    frame->a0 = AllocateUserMemory(CurrentProcess(), frame->a0);
                },
                SystemCall::Free => {
                    FreeUserMemory(CurrentProcess(), frame->a0);
                },
                SystemCall::ConsoleRead => {
                    if frame->a0 == 0 || frame->a1 == 0 {
                        frame->a0 = 0;
                    } else if !HasCharacter() {
                        frame->epc -= 4;
                        processes[CurrentProcess() as usize].state = ProcessState::Waiting;
                        return Schedule(frame);
                    } else {
                        (frame->a0 as *mut i8)[0] = ReadCharacter();
                        frame->a0 = 1;
                    }
                },
                SystemCall::ConsoleWrite => {
                    frame->a0 = WriteBuffer(frame->a0 as *i8, frame->a1 as usize) as u32;
                },
                SystemCall::PathKind => {
                    frame->a0 = GetPathKind(frame->a0 as *i8);
                },
                SystemCall::CanonicalPath => {
                    frame->a0 = GetCanonicalPath(frame->a0 as *i8, frame->a1 as *mut i8, frame->a2 as usize);
                },
                SystemCall::ReadFile => {
                    frame->a0 = ReadWholeFile(frame->a0 as *i8, frame->a1 as *mut u8, frame->a2 as usize, frame->a3 as *mut usize);
                },
                SystemCall::WriteFile => {
                    frame->a0 = WriteFile(frame->a0 as *i8, frame->a1 as *u8, frame->a2);
                },
                SystemCall::RemoveFile => {
                    frame->a0 = RemoveFile(frame->a0 as *i8);
                },
                SystemCall::Sleep => {
                    let milliseconds = frame->a0;
                    let process = &mut processes[CurrentProcess() as usize];
                    process.wake_tick = ticks + (milliseconds + MILLISECONDS_PER_TICK - 1) / MILLISECONDS_PER_TICK;
                    process.state = ProcessState::Sleeping;
                    return Schedule(frame);
                },
                SystemCall::CommandLine => {
                    frame->a0 = GetCommandLine(frame->a0 as *mut i8, frame->a1 as usize) as u32;
                },
                SystemCall::Open => {
                    frame->a0 = OpenFile(frame->a0 as *i8, frame->a1, frame->a2 as *mut u32);
                },
                SystemCall::Close => {
                    frame->a0 = CloseFile(frame->a0);
                },
                SystemCall::Read => {
                    frame->a0 = ReadHandle(frame->a0, frame->a1 as *mut u8, frame->a2, frame->a3 as *mut u32);
                },
                SystemCall::Write => {
                    frame->a0 = WriteHandle(frame->a0, frame->a1 as *u8, frame->a2);
                },
                SystemCall::Seek => {
                    frame->a0 = SeekHandle(frame->a0, frame->a1 as i32, frame->a2, frame->a3 as *mut u32);
                },
                SystemCall::Size => {
                    frame->a0 = GetFileSize(frame->a0, frame->a1 as *mut u32);
                },
                SystemCall::ListFolder => {
                    frame->a0 = ListFolder(frame->a0 as *i8, frame->a1 as *mut u8, frame->a2, frame->a3 as *mut u32);
                },
                SystemCall::CreateFolder => {
                    frame->a0 = CreateFolder(frame->a0 as *i8);
                },
                SystemCall::RemoveFolder => {
                    frame->a0 = RemoveFolder(frame->a0 as *i8);
                },
                SystemCall::ChangeFolder => {
                    frame->a0 = ChangeFolder(frame->a0 as *i8);
                },
                SystemCall::Rename => {
                    frame->a0 = RenamePath(frame->a0 as *i8, frame->a1 as *i8);
                },
                SystemCall::Move => {
                    frame->a0 = MovePath(frame->a0 as *i8, frame->a1 as *i8);
                },
                SystemCall::Copy => {
                    frame->a0 = CopyFile(frame->a0 as *i8, frame->a1 as *i8);
                },
                SystemCall::Execute => {
                    let mut child = NO_PROCESS;
                    frame->a0 = ExecuteFile(frame->a0 as *i8, frame->a1 as *i8, &mut child);

                    if frame->a0 == FILE_OK {
                        let process = &mut processes[CurrentProcess() as usize];
                        process.child = child;
                        process.child_status = frame->a2 as *mut i32;
                        process.state = ProcessState::Joining;
                        return Schedule(frame);
                    }
                },
                SystemCall::Spawn => {
                    frame->a0 = SpawnFile(frame->a0 as *i8, frame->a1 as *i8, frame->a2 as *mut u32);
                },
                SystemCall::Kill => {
                    frame->a0 = KillProcess(frame->a0);
                },
                SystemCall::ListProcesses => {
                    frame->a0 = ListProcesses(frame->a0 as *mut ProcessRecord, frame->a1, frame->a2 as *mut u32);
                },
                SystemCall::SystemInformation => {
                    frame->a0 = GetSystemInformation(frame->a0 as *mut SystemInformation);
                },
                SystemCall::DiskStatistics => {
                    frame->a0 = GetDiskStatistics(frame->a0 as *mut DiskStatistics);
                },
                SystemCall::HeapStatistics => {
                    frame->a0 = GetHeapStatisticsInto(frame->a0 as *mut HeapStatistics);
                },
                SystemCall::DebugPeek => {
                    frame->a0 = DebugPeek(frame->a0, frame->a1 as *mut u32);
                },
                SystemCall::DebugPoke => {
                    frame->a0 = DebugPoke(frame->a0, frame->a1);
                },
                SystemCall::DebugRead => {
                    frame->a0 = DebugRead(frame->a0, frame->a1 as *mut u8, frame->a2);
                },
                SystemCall::SetAnimation => {
                    frame->a0 = SetAnimationMode(frame->a0, frame->a1);
                },
                SystemCall::SetLEDs => {
                    SetLEDs(frame->a0 as i8);
                    frame->a0 = FILE_OK;
                },
                SystemCall::ThreadCreate => {
                    frame->a0 = CreateThread(frame->a0, frame->a1, frame->a2);
                },
                SystemCall::ThreadExit => {
                    if IsThread(CurrentProcess()) {
                        ReleaseMember(CurrentProcess());
                    } else {
                        EndGroup(CurrentProcess(), FILE_OK, frame->a0 as i32, true);
                    }

                    return Schedule(frame);
                },
                SystemCall::Yield => {
                    return Schedule(frame);
                },
                SystemCall::FutexWait => {
                    if WaitOnAddress(frame, frame->a0, frame->a1, frame->a2) {
                        return Schedule(frame);
                    }
                },
                SystemCall::FutexWake => {
                    frame->a0 = WakeAddress(frame->a0, frame->a1);
                },
                SystemCall::ProcessorCount => {
                    frame->a0 = OnlineCores();
                },
                SystemCall::ConsolePending => {
                    frame->a0 = HasCharacter() as u32;
                },
                _ => {
                    frame->a0 = 0xFFFFFFFF;
                }
            }
        },
        _ => {}
    }

    frame
}
