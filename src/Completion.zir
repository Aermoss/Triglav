#[include "src/Console.zir", "src/Strings.zir", "src/Memory.zir", "src/FileSystem.zir" : *]

const COMPLETION_SCREEN_COLUMNS: u32 = 80;
const COMPLETION_NAME_LENGTH: usize = 32;

static mut completion_folder: [i8; 256];
static mut completion_prefix: [i8; 256];
static mut completion_common: [i8; 256];
static mut completion_name: [i8; 32];
static mut completion_count: u32 = 0;
static mut completion_width: u32 = 0;
static mut completion_column: u32 = 0;
static mut completion_written: u32 = 0;
static mut completion_folder_match: bool = false;
static mut completion_listing: bool = false;

fn StartsWithName(name: *i8, prefix: *i8) -> bool {
    let (mut i, mut j): (usize, usize) = (0, 0);

    while prefix[j] != '\0' {
        if name[i] == '\0' || NextCode(name, &mut i) != NextCode(prefix, &mut j) {
            return false;
        }
    }

    true
}

fn NameWidth(name: *i8, folder: bool) -> u32 {
    let mut width = Columns(name, 0, StringLength(name) as usize) as u32;

    if folder {
        width += 1;
    }

    width
}

fn ListCandidate(name: *i8, folder: bool) {
    let mut start = completion_column;

    if start > 0 && start + completion_width >= COMPLETION_SCREEN_COLUMNS {
        WriteCharacter('\n');
        start = 0;
        completion_written = 0;
    }

    while completion_written < start {
        WriteCharacter(' ');
        completion_written += 1;
    }

    Write(name);

    if folder {
        WriteCharacter('/');
    }

    completion_written = start + NameWidth(name, folder);
    completion_column = start + completion_width + 2;
}

fn AddCandidate(name: *i8, folder: bool) {
    if !StartsWithName(name, &completion_prefix[0] as *i8) {
        return;
    }

    if completion_listing {
        ListCandidate(name, folder);
        return;
    }

    if completion_count == 0 {
        CopyText(&mut completion_common[0], name, 256);
        completion_folder_match = folder;
    } else {
        let (mut i, mut j): (usize, usize) = (0, 0);

        while completion_common[i] != '\0' && name[j] != '\0' {
            let start = i;

            if NextCode(&completion_common[0] as *i8, &mut i) != NextCode(name, &mut j) {
                i = start;
                break;
            }
        }

        completion_common[i] = '\0';
    }

    let width = NameWidth(name, folder);

    if width > completion_width {
        completion_width = width;
    }

    completion_count += 1;
}

fn AddCommands(commands: *i8) {
    let mut i: usize = 0;

    while commands[i] != '\0' {
        let mut length: usize = 0;

        while commands[i] != '\0' && commands[i] != ' ' {
            if length + 1 < COMPLETION_NAME_LENGTH {
                completion_name[length] = commands[i];
                length += 1;
            }

            i += 1;
        }

        completion_name[length] = '\0';

        if length > 0 {
            AddCandidate(&completion_name[0] as *i8, false);
        }

        while commands[i] == ' ' {
            i += 1;
        }
    }
}

fn CollectCandidates(commands: *i8) {
    if commands != null {
        AddCommands(commands);
    }

    let folder = &completion_folder[0] as *i8;
    let mut count: u32 = 0;

    if ListFolder(folder, null, 0, &mut count) != FILE_OK || count == 0 {
        return;
    }

    let buffer = Allocate(count * LIST_ENTRY_SIZE);

    if buffer == null {
        return;
    }

    if ListFolder(folder, buffer, count, &mut count) == FILE_OK {
        let mut i: u32 = 0;

        while i < count {
            let record = buffer + (i * LIST_ENTRY_SIZE) as usize;
            let fields = (record + FILE_NAME_LENGTH as usize) as *u32;
            AddCandidate(record as *i8, fields[0] == KIND_FOLDER);
            i += 1;
        }
    }

    Free(buffer);
}

fn CopyRange(output: *mut i8, position: usize, source: *i8, start: usize, end: usize) -> usize {
    let mut i = start;
    let mut at = position;

    while i < end {
        output[at] = source[i];
        at += 1;
        i += 1;
    }

    at
}

fn CompleteLine(commands: *i8, line: *i8, cursor: usize, output: *mut i8, length: usize, target: *mut usize) -> u32 {
    let mut start: usize = 0;
    let mut words: u32 = 0;
    let mut inside = false;
    let mut quoted = false;
    let mut closed = false;
    let mut i: usize = 0;

    while i < cursor {
        let character = line[i];

        if !inside {
            if character != ' ' {
                inside = true;
                start = i;
                quoted = character == '"';
                closed = false;
                words += 1;
            }
        } else if quoted && !closed {
            if character == '"' {
                closed = true;
            }
        } else if character == ' ' {
            inside = false;
        }

        i += 1;
    }

    if words == 0 {
        return COMPLETION_NONE;
    }

    if !inside {
        start = cursor;
        quoted = false;
        words += 1;
    } else if closed {
        return COMPLETION_NONE;
    }

    let text_start = if quoted { start + 1 } else { start };
    let mut slash = text_start;
    i = text_start;

    while i < cursor {
        if line[i] == '/' {
            slash = i + 1;
        }

        i += 1;
    }

    let folder_length = slash - text_start;

    if folder_length == 0 {
        completion_folder[0] = '.';
        completion_folder[1] = '\0';
    } else {
        let end = CopyRange(&mut completion_folder[0], 0, line, text_start, slash);
        let last = if end > 1 { end - 1 } else { end };
        completion_folder[last] = '\0';
    }

    let prefix_end = CopyRange(&mut completion_prefix[0], 0, line, slash, cursor);
    completion_prefix[prefix_end] = '\0';
    completion_count = 0;
    completion_width = 0;
    completion_listing = false;
    completion_common[0] = '\0';
    let names = if words == 1 && folder_length == 0 { commands } else { null };
    CollectCandidates(names);

    if completion_count == 0 {
        return COMPLETION_NONE;
    }

    let common_length = StringLength(&completion_common[0] as *i8) as usize;

    if completion_count > 1 && Columns(&completion_common[0] as *i8, 0, common_length) <= Columns(&completion_prefix[0] as *i8, 0, prefix_end) {
        WriteCharacter('\n');
        completion_listing = true;
        completion_column = 0;
        completion_written = 0;
        CollectCandidates(names);
        completion_listing = false;
        WriteCharacter('\n');
        return COMPLETION_LISTED;
    }

    let mut spaced = false;
    i = 0;

    while i < common_length {
        if completion_common[i] == ' ' {
            spaced = true;
        }

        i += 1;
    }

    let open = quoted || spaced;
    let single = completion_count == 1;
    let line_length = StringLength(line) as usize;
    let mut suffix_length: usize = 0;

    if single {
        if completion_folder_match || !open {
            suffix_length = 1;
        } else {
            suffix_length = 2;
        }
    }

    let mut total = start + folder_length + common_length + suffix_length + line_length - cursor;

    if open {
        total += 1;
    }

    if total + 1 > length {
        return COMPLETION_NONE;
    }

    let mut at = CopyRange(output, 0, line, 0, start);

    if open {
        output[at] = '"';
        at += 1;
    }

    at = CopyRange(output, at, line, text_start, slash);
    at = CopyRange(output, at, &completion_common[0] as *i8, 0, common_length);

    if single {
        if completion_folder_match {
            output[at] = '/';
            at += 1;
        } else {
            if open {
                output[at] = '"';
                at += 1;
            }

            output[at] = ' ';
            at += 1;
        }
    }

    *target = at;
    at = CopyRange(output, at, line, cursor, line_length);
    output[at] = '\0';
    COMPLETION_CHANGED
}
