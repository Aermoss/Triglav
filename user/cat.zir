#[include "Common/System.zir" : *]

const SYSTEM_CONSOLE_WRITE: u32 = 4;

fn WriteBytes(data: *u8, length: u32) {
    volatile asm : a7(SYSTEM_CONSOLE_WRITE), a0(data), a1(length) -> {
        ecall
    } : memory;
}

const CAT_BUFFER_SIZE: usize = 512;

fn Main(args: &mut Vector<String>) -> i32 {
    if args.Length() != 2 {
        WriteLine("Usage: cat <file>");
        return 1;
    }

    let mut file = File();

    if let Result<(), IOError>::Err(error) = file.Open(args[1], FileMode::Read) {
        WriteLine(ErrorMessage(error));
        return 1;
    }

    let mut buffer: [u8; 512];

    loop {
        match file.Read(&mut buffer[0], CAT_BUFFER_SIZE) {
            Result<usize, IOError>::Ok(count) => {
                if count == 0 {
                    break;
                }

                WriteBytes(&buffer[0] as *u8, count as u32);
            },
            Result<usize, IOError>::Err(error) => {
                WriteLine(ErrorMessage(error));
                return 1;
            }
        }
    }

    0
}
