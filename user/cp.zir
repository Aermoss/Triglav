#[include "Common/System.zir" : *]

const SYSTEM_COPY: u32 = 24;

fn CopyFile(source: &String, destination: &String) -> u32 {
    let mut result: u32 = 0;

    volatile asm : a7(SYSTEM_COPY), a0(source.Data()), a1(destination.Data()) -> {
        ecall
    } -> a0(result) : memory;

    result
}

fn Main(args: &mut Vector<String>) -> i32 {
    if args.Length() != 3 {
        WriteLine("Usage: cp <source> <target>");
        return 1;
    }

    let code = CopyFile(args[1], args[2]);

    if code != FILE_OK {
        WriteLine(ErrorMessage(code));
        return 1;
    }

    0
}
