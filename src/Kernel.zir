#[include "src/Devices.zir", "src/Console.zir", "src/Memory.zir", "src/Process.zir", "src/Interrupts.zir", "src/Animation.zir", "src/FileSystem.zir", "src/Executable.zir", "src/Shell.zir" : *]

const SHELL_STACK_SIZE: u32 = 16384;

@nomangle
fn Main(image_end: u32) {
    InitializeUARTs();
    SetBaudRate(BAUD_RATE);
    SetLEDs(0x3F);
    InitializeScreen();
    InitializeMemory(image_end);
    InitializeFileSystem();
    InitializeProcesses();
    SpawnWithStack("shell", RunShell, 0, SHELL_STACK_SIZE);
    Spawn("anim", RunAnimation, 0);
    WriteLine("Triglav kernel started.");

    if HasFileSystem() {
        Write("SD card: ");
        WriteInteger(sd_sectors / 2048);
        Write(" MB, ");
        WriteLine(FileSystemName());
    } else {
        WriteLine("No SD card with a FAT32 or exFAT file system was found.");
    }

    WriteLine("Type help to see the commands.");
    InitializeInterrupts();
    Yield();

    loop {
        WaitForInterrupt();
    }
}
