#[include "Common/System.zir", "Common/Format.zir" : *]

const SYSTEM_LIST_PROCESSES: u32 = 28;
const MAX_PROCESSES: u32 = 16;
const PROCESS_BRAM_STACK: u32 = 1;
const PROCESS_CURRENT: u32 = 4;

struct ProcessRecord {
    pub id: u32,
    pub state: u32,
    pub ticks: u32,
    pub flags: u32,
    pub stack_bottom: u32,
    pub name: [i8; 32]
}

fn ListProcesses() -> Vector<ProcessRecord> {
    let mut records: [ProcessRecord; 16];
    let mut count: u32 = 0;
    let mut result: u32 = 0;

    volatile asm : a7(SYSTEM_LIST_PROCESSES), a0(&mut records[0] as *mut ProcessRecord), a1(MAX_PROCESSES), a2(&mut count as *mut u32) -> {
        ecall
    } -> a0(result) : memory;

    let mut processes = Vector<ProcessRecord>();

    if result == FILE_OK {
        for i in 0..count {
            processes.PushBack(records[i as usize]);
        }
    }

    processes
}

fn StateName(record: &ProcessRecord) -> *i8 {
    match record.state {
        0 => "free",
        1 => if (record.flags & PROCESS_CURRENT) != 0 { "running" } else { "ready" },
        2 => "sleeping",
        3 => "waiting",
        4 => "joining",
        5 => "crashed",
        6 => "loading",
        _ => "unknown"
    }
}

fn Main(args: &mut Vector<String>) -> i32 {
    WriteLine("PID  STATE     TICKS     STACK             NAME");

    for record in ListProcesses() {
        let stack = if (record.flags & PROCESS_BRAM_STACK) != 0 { "bram" } else { "sdram" };

        WriteLine(PadRight(String::FromInteger(record.id), 5) + PadRight(StateName(record).ToString(), 10) + PadRight(String::FromInteger(record.ticks), 10) +
            PadRight(stack.ToString(), 6) + Address(record.stack_bottom) + "  " + (&record.name[0] as *i8).ToString());
    }

    0
}
