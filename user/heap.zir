#[include "Common/System.zir", "Common/Format.zir" : *]

const SYSTEM_HEAP_STATISTICS: u32 = 31;

struct HeapStatistics {
    pub used: u32,
    pub free: u32,
    pub largest: u32
}

fn GetHeapStatistics() -> HeapStatistics {
    let mut statistics: HeapStatistics;

    volatile asm : a7(SYSTEM_HEAP_STATISTICS), a0(&mut statistics as *mut HeapStatistics) -> {
        ecall
    } : memory;

    statistics
}

fn Main(args: &mut Vector<String>) -> i32 {
    let info = GetSystemInformation();
    WriteLine(Range("Heap:    ", info.heap_start, info.heap_end));

    let statistics = GetHeapStatistics();
    WriteLine("Used:    " + String::FromInteger(statistics.used) + " bytes");
    WriteLine("Free:    " + String::FromInteger(statistics.free) + " bytes, the largest block is " + String::FromInteger(statistics.largest) + " bytes");
    0
}
