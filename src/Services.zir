#[include "src/Devices.zir", "src/Memory.zir", "src/Process.zir", "src/FileSystem.zir", "src/Executable.zir", "src/Animation.zir", "src/SD.zir" : *]

const PROCESS_NAME_LENGTH: usize = 32;

const PROCESS_BRAM_STACK: u32 = 1;
const PROCESS_USER: u32 = 2;
const PROCESS_CURRENT: u32 = 4;

const SYSTEM_FILE_SYSTEM: u32 = 1;
const SYSTEM_BLOCK_ADDRESSING: u32 = 2;

struct ProcessRecord {
    pub id: u32,
    pub state: u32,
    pub ticks: u32,
    pub flags: u32,
    pub stack_bottom: u32,
    pub name: [i8; 32]
}

struct SystemInformation {
    pub clock_frequency: u32,
    pub uptime: u32,
    pub ticks: u32,
    pub stacks_start: u32,
    pub stacks_end: u32,
    pub kernel_start: u32,
    pub kernel_end: u32,
    pub heap_start: u32,
    pub heap_end: u32,
    pub flash_start: u32,
    pub flash_end: u32,
    pub sd_sectors: u32,
    pub cluster_bytes: u32,
    pub flags: u32,
    pub file_system: [i8; 16]
}

struct DiskStatistics {
    pub total: u32,
    pub free: u32,
    pub bytes: u32
}

struct HeapStatistics {
    pub used: u32,
    pub free: u32,
    pub largest: u32
}

static mut init_process: u32 = NO_PROCESS;

fn CopyName(destination: *mut i8, source: *i8, capacity: usize) {
    let mut i: usize = 0;

    while i + 1 < capacity && source != null && source[i] != '\0' {
        destination[i] = source[i];
        i += 1;
    }

    destination[i] = '\0';
}

fn SpawnFile(path: *i8, command_line: *i8, result: *mut u32) -> u32 {
    let mut child = NO_PROCESS;
    let code = ExecuteFile(path, command_line, &mut child);

    if code == FILE_OK {
        *result = child;
    }

    code
}

fn KillProcess(id: u32) -> u32 {
    if id == 0 || id == current_process || id == init_process || id >= MAX_PROCESSES {
        return FILE_NOT_ALLOWED;
    }

    if Kill(id) { FILE_OK } else { FILE_NOT_FOUND }
}

fn ListProcesses(buffer: *mut ProcessRecord, capacity: u32, count: *mut u32) -> u32 {
    let mut found: u32 = 0;
    let mut id: u32 = 0;

    while id < MAX_PROCESSES {
        let process = &processes[id as usize];

        if process.state != ProcessState::Free {
            if buffer != null && found < capacity {
                let record = &mut buffer[found as usize];
                record.id = id;
                record.state = process.state as u32;
                record.ticks = process.ticks;
                record.flags = 0;

                if IsStackInBRAM(id) {
                    record.flags |= PROCESS_BRAM_STACK;
                }

                if IsUserProcess(id) {
                    record.flags |= PROCESS_USER;
                }

                if id == current_process {
                    record.flags |= PROCESS_CURRENT;
                }

                record.stack_bottom = process.stack_bottom;
                CopyName(&mut record.name[0], process.name, PROCESS_NAME_LENGTH);
            }

            found += 1;
        }

        id += 1;
    }

    *count = found;
    if buffer != null && found > capacity { FILE_NO_SPACE } else { FILE_OK }
}

fn GetSystemInformation(info: *mut SystemInformation) -> u32 {
    info->clock_frequency = CLK_FREQ;
    info->uptime = GetTime();
    info->ticks = ticks;
    (info->stacks_start, info->stacks_end) = (STACKS_START, STACKS_END);
    (info->kernel_start, info->kernel_end) = (SDRAM_START, kernel_end);
    (info->heap_start, info->heap_end) = (heap_start, heap_end);
    (info->flash_start, info->flash_end) = (FLASH_START, FLASH_END);
    info->sd_sectors = sd_sectors;
    info->cluster_bytes = 0;
    info->flags = 0;
    info->file_system[0] = '\0';

    if HasFileSystem() {
        info->flags |= SYSTEM_FILE_SYSTEM;
        info->cluster_bytes = cluster_bytes;
        CopyName(&mut info->file_system[0], FileSystemName(), 16);
    }

    if sd_block_addressing {
        info->flags |= SYSTEM_BLOCK_ADDRESSING;
    }

    FILE_OK
}

fn GetDiskStatistics(statistics: *mut DiskStatistics) -> u32 {
    let (mut total, mut free, mut bytes) = (0u32, 0u32, 0u32);
    let code = FileSystemStatistics(&mut total, &mut free, &mut bytes);

    if code == FILE_OK {
        (statistics->total, statistics->free, statistics->bytes) = (total, free, bytes);
    }

    code
}

fn GetHeapStatisticsInto(statistics: *mut HeapStatistics) -> u32 {
    let (mut used, mut free, mut largest) = (0u32, 0u32, 0u32);
    GetHeapStatistics(&mut used, &mut free, &mut largest);
    (statistics->used, statistics->free, statistics->largest) = (used, free, largest);
    FILE_OK
}

fn DebugPeek(address: u32, value: *mut u32) -> u32 {
    if (address & 3) != 0 {
        return FILE_NOT_ALLOWED;
    }

    *value = *(address as *u32);
    FILE_OK
}

fn DebugPoke(address: u32, value: u32) -> u32 {
    if (address & 3) != 0 {
        return FILE_NOT_ALLOWED;
    }

    *(address as *mut u32) = value;
    FILE_OK
}

fn DebugRead(address: u32, buffer: *mut u8, length: u32) -> u32 {
    let mut i: u32 = 0;

    while i < length {
        buffer[i as usize] = *((address + i) as *u8);
        i += 1;
    }

    FILE_OK
}

fn SetAnimationMode(mode: u32, brightness: u32) -> u32 {
    if mode >= ANIMATION_MODES || (brightness > 255 && brightness != 0xFFFFFFFF) {
        return FILE_NOT_ALLOWED;
    }

    animation_mode = mode;

    if brightness != 0xFFFFFFFF {
        animation_brightness = brightness as u8;
    }

    FILE_OK
}
