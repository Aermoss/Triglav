#[include "std/io", "std/str", "std/vec" : *]

fn Main(args: &mut Vector<String>) -> i32 {
    let mut text = String();

    for i in 1..args.Length() {
        if i > 1 {
            text += ' ';
        }

        text += args[i];
    }

    WriteLine(text);
    0
}
