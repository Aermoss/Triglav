#[include "src/Devices.zir", "src/Console.zir", "src/Strings.zir", "src/Memory.zir", "src/FileSystem.zir", "src/ESP.zir", "src/WiFi.zir" : *]

const DNS_PORT: u32 = 53;
const DNS_PACKET_SIZE: u32 = 512;
const DNS_NAME_SIZE: usize = 256;

static mut dns_packet: [u8; 512];
static mut dns_length: u32 = 0;
static mut dns_name: [i8; 256];
static mut dns_server: [i8; 64];

fn DNSWord(offset: u32) -> u32 {
    (dns_packet[offset as usize] as u32 << 8) | dns_packet[(offset + 1) as usize] as u32
}

fn DNSBuildQuery(name: *i8, id: u32) -> u32 {
    (dns_packet[0], dns_packet[1]) = ((id >> 8) as u8, id as u8);
    (dns_packet[2], dns_packet[3]) = (0x01, 0x00);
    (dns_packet[4], dns_packet[5]) = (0, 1);

    for i in 6..12 {
        dns_packet[i as usize] = 0;
    }

    let mut length: u32 = 12;
    let mut current = name;

    while *current != '\0' {
        let start = length;
        length += 1;
        let mut count: u32 = 0;

        while *current != '\0' && *current != '.' {
            if count == 63 || length + 6 >= DNS_PACKET_SIZE {
                return 0;
            }

            dns_packet[length as usize] = *current as u8;
            (length, count, current) = (length + 1, count + 1, current + 1);
        }

        if count == 0 {
            return 0;
        }

        dns_packet[start as usize] = count as u8;

        if *current == '.' {
            current += 1;
        }
    }

    if length == 12 {
        return 0;
    }

    dns_packet[length as usize] = 0;
    (dns_packet[(length + 1) as usize], dns_packet[(length + 2) as usize]) = (0, 1);
    (dns_packet[(length + 3) as usize], dns_packet[(length + 4) as usize]) = (0, 1);
    length + 5
}

fn DNSSkipName(mut offset: u32) -> u32 {
    while offset < dns_length {
        let size = dns_packet[offset as usize] as u32;

        if size == 0 {
            return offset + 1;
        }

        if (size & 0xC0) == 0xC0 {
            return offset + 2;
        }

        offset += size + 1;
    }

    dns_length + 1
}

fn DNSReadName(mut offset: u32) -> bool {
    let mut length: usize = 0;
    let mut jumps: u32 = 0;

    while offset < dns_length {
        let size = dns_packet[offset as usize] as u32;

        if size == 0 {
            dns_name[length] = '\0';
            return true;
        }

        if (size & 0xC0) == 0xC0 {
            if offset + 1 >= dns_length || jumps == 16 {
                return false;
            }

            offset = ((size & 0x3F) << 8) | dns_packet[(offset + 1) as usize] as u32;
            jumps += 1;
            continue;
        }

        if offset + size >= dns_length || length + size as usize + 2 > DNS_NAME_SIZE {
            return false;
        }

        if length > 0 {
            dns_name[length] = '.';
            length += 1;
        }

        for i in 0..size {
            dns_name[length] = dns_packet[(offset + 1 + i) as usize] as i8;
            length += 1;
        }

        offset += size + 1;
    }

    false
}

fn WriteAddress(offset: u32) {
    for i in 0..4 {
        if i > 0 {
            WriteCharacter('.');
        }

        WriteInteger(dns_packet[(offset + i as u32) as usize] as u32);
    }
}

fn DNSResolve(name: *i8, server: *i8) {
    let id = GetTime() & 0xFFFF;
    let query_length = DNSBuildQuery(name, id);

    if query_length == 0 {
        WriteLine("the name is not valid");
        return;
    }

    if !ESPReady() {
        return;
    }

    ESPCommand("ATE0", 1000);
    ESPClose();

    if ESPOpen("UDP", server, DNS_PORT) != ESPResult::Ok {
        WriteLine("the DNS server could not be reached, is WiFi connected?");
        return;
    }

    if !ESPSend(&dns_packet[0], query_length) {
        ESPClose();
        WriteLine("the DNS query could not be sent");
        return;
    }

    dns_length = ESPReceive(&mut dns_packet[0], DNS_PACKET_SIZE, 5000);
    ESPClose();

    if dns_length < 12 || DNSWord(0) != id || (DNSWord(2) & 0x8000) == 0 {
        WriteLine("the DNS server did not answer");
        return;
    }

    let code = DNSWord(2) & 0xF;

    if code == 3 {
        Write(name);
        WriteLine(" was not found");
        return;
    }

    if code != 0 {
        Write("the DNS server failed with code ");
        WriteInteger(code);
        WriteCharacter('\n');
        return;
    }

    let mut offset: u32 = 12;

    for _ in 0..DNSWord(4) {
        offset = DNSSkipName(offset) + 4;
    }

    let mut addresses: u32 = 0;

    for _ in 0..DNSWord(6) {
        offset = DNSSkipName(offset);

        if offset + 10 > dns_length {
            break;
        }

        let kind = DNSWord(offset);
        let size = DNSWord(offset + 8);
        offset += 10;

        if offset + size > dns_length {
            break;
        }

        if kind == 1 && size == 4 {
            Write(name);
            Write(" has address ");
            WriteAddress(offset);
            WriteCharacter('\n');
            addresses += 1;
        } else if kind == 5 && DNSReadName(offset) {
            Write(name);
            Write(" is an alias for ");
            WriteLine(&dns_name[0]);
        }

        offset += size;
    }

    if addresses == 0 {
        Write(name);
        WriteLine(" has no IPv4 address");
    }
}

fn CommandHost(arguments: *i8) {
    let rest = ParseArgument(arguments, &mut wifi_name[0], WIFI_FIELD_SIZE);

    if rest == null || wifi_name[0] == '\0' {
        WriteLine("usage: host <name> [DNS server]");
        return;
    }

    if AtEnd(rest) {
        let default_server = "8.8.8.8";

        for i in 0..8 {
            dns_server[i as usize] = default_server[i as usize];
        }
    } else if ParseArgument(rest, &mut dns_server[0], 64) == null {
        WriteLine("usage: host <name> [DNS server]");
        return;
    }

    DNSResolve(&wifi_name[0], &dns_server[0]);
}

const GET_INITIAL_SIZE: u32 = 32768;
const GET_LIMIT: u32 = 1048576;
const GET_PACKET_SIZE: u32 = 2048;
const GET_TIMEOUT: u32 = 15000;

static mut get_url: [i8; 256];
static mut get_path: [i8; 128];
static mut get_host: [i8; 128];
static mut get_request: [i8; 512];
static mut get_request_length: u32 = 0;

fn RequestAppend(mut text: *i8) -> bool {
    while *text != '\0' {
        if get_request_length + 1 >= 512 {
            return false;
        }

        get_request[get_request_length as usize] = *text;
        get_request_length += 1;
        text += 1;
    }

    true
}

fn RequestAppendNumber(value: u32) -> bool {
    if value >= 10 && !RequestAppendNumber(value / 10) {
        return false;
    }

    let digit = ['0' + (value % 10) as i8, '\0'];
    RequestAppend(&digit[0])
}

fn ParseURL(url: *i8, port: *mut u32) -> *i8 {
    let mut current = url;
    let plain = TextStartsWith(current, "http://");

    if plain != null {
        current = plain;
    }

    let mut length: usize = 0;

    while *current != '\0' && *current != ':' && *current != '/' {
        if length + 1 >= 128 {
            return null;
        }

        get_host[length] = *current;
        (length, current) = (length + 1, current + 1);
    }

    get_host[length] = '\0';
    *port = 80;

    if length == 0 {
        return null;
    }

    if *current == ':' {
        current += 1;
        let mut value: u32 = 0;
        let start = current;

        while *current >= '0' && *current <= '9' {
            value = value * 10 + (*current - '0') as u32;
            current += 1;
        }

        if current == start || value == 0 || value > 65535 {
            return null;
        }

        *port = value;
    }

    if *current == '\0' { "/" } else if *current == '/' { current } else { null }
}

fn LowerCase(character: i8) -> i8 {
    if character >= 'A' && character <= 'Z' { character - 'A' + 'a' } else { character }
}

fn HeaderValue(data: *u8, end: u32, name: *i8, value: *mut u32) -> bool {
    let mut line: u32 = 0;

    while line < end {
        let mut i: u32 = 0;

        while name[i as usize] != '\0' && line + i < end && LowerCase(data[(line + i) as usize] as i8) == name[i as usize] {
            i += 1;
        }

        if name[i as usize] == '\0' {
            let mut position = line + i;
            let mut result: u32 = 0;

            while position < end && data[position as usize] == ' ' as u8 {
                position += 1;
            }

            let start = position;

            while position < end && data[position as usize] >= '0' as u8 && data[position as usize] <= '9' as u8 {
                result = result * 10 + (data[position as usize] - '0' as u8) as u32;
                position += 1;
            }

            if position == start {
                return false;
            }

            *value = result;
            return true;
        }

        while line < end && data[line as usize] != '\n' as u8 {
            line += 1;
        }

        line += 1;
    }

    false
}

fn HeaderEnd(data: *u8, length: u32) -> u32 {
    let mut i: u32 = 0;

    while i + 3 < length {
        if data[i as usize] == '\r' as u8 && data[(i + 1) as usize] == '\n' as u8 && data[(i + 2) as usize] == '\r' as u8 && data[(i + 3) as usize] == '\n' as u8 {
            return i + 4;
        }

        i += 1;
    }

    0
}

fn StatusCode(data: *u8, length: u32) -> u32 {
    if length < 12 || TextStartsWith(data as *i8, "HTTP/1.") == null {
        return 0;
    }

    let mut code: u32 = 0;

    for i in 9..12 {
        let digit = data[i as usize];

        if digit < '0' as u8 || digit > '9' as u8 {
            return 0;
        }

        code = code * 10 + (digit - '0' as u8) as u32;
    }

    code
}

fn WriteStatusLine(data: *u8, length: u32) {
    let mut i: u32 = 0;

    while i < length && data[i as usize] != '\r' as u8 && data[i as usize] != '\n' as u8 {
        WriteCharacter(data[i as usize] as i8);
        i += 1;
    }

    WriteCharacter('\n');
}

fn Download(path: *i8, port: u32, file: *i8) {
    if !ESPReady() {
        return;
    }

    ESPCommand("ATE0", 1000);
    ESPClose();

    if ESPOpen("TCP", &get_host[0], port) != ESPResult::Ok {
        Write("could not connect to ");
        WriteLine(&get_host[0]);
        return;
    }

    get_request_length = 0;
    let mut fits = RequestAppend("GET ") && RequestAppend(path) && RequestAppend(" HTTP/1.0\r\nHost: ") && RequestAppend(&get_host[0]);

    if port != 80 {
        fits = fits && RequestAppend(":") && RequestAppendNumber(port);
    }

    fits = fits && RequestAppend("\r\nUser-Agent: Triglav\r\nConnection: close\r\n\r\n");

    if !fits {
        ESPClose();
        WriteLine("the address is too long");
        return;
    }

    let mut capacity = GET_INITIAL_SIZE;
    let mut data = Allocate(capacity);

    if data == null {
        ESPClose();
        WriteLine(FileErrorMessage(FILE_NO_MEMORY));
        return;
    }

    let started = GetTime();

    if !ESPSend(&get_request[0] as *u8, get_request_length) {
        Free(data);
        ESPClose();
        WriteLine("the request could not be sent");
        return;
    }

    let mut length: u32 = 0;
    let mut reported: u32 = 0;
    let mut complete = false;

    loop {
        if capacity - length < GET_PACKET_SIZE {
            if capacity >= GET_LIMIT {
                break;
            }

            let larger = Allocate(capacity * 2);

            if larger == null {
                break;
            }

            for i in 0..length {
                larger[i as usize] = data[i as usize];
            }

            Free(data);
            (data, capacity) = (larger, capacity * 2);
        }

        let received = ESPReceivePacket(data + length as usize, capacity - length, GET_TIMEOUT);

        if received == ESP_CLOSED {
            complete = true;
            break;
        }

        if received == 0 {
            break;
        }

        length += received;

        if length - reported >= 16384 {
            reported = length;
            WriteCharacter('\r');
            WriteInteger(length);
            Write(" bytes");
        }
    }

    ESPClose();

    if reported != 0 {
        WriteCharacter('\n');
    }

    if !complete {
        Free(data);
        WriteLine(if capacity - length < GET_PACKET_SIZE { "the file is larger than 1 MB" } else { "the transfer stalled" });
        return;
    }

    let header_end = HeaderEnd(data, length);
    let status = StatusCode(data, length);

    if header_end == 0 || status == 0 {
        Free(data);
        WriteLine("the server did not send an HTTP response");
        return;
    }

    if status != 200 {
        Write("the server answered: ");
        WriteStatusLine(data, length);
        Free(data);
        return;
    }

    let body_length = length - header_end;
    let mut expected: u32 = 0;

    if HeaderValue(data, header_end, "content-length:", &mut expected) && expected != body_length {
        Write("the transfer was cut short, ");
        WriteInteger(body_length);
        Write(" of ");
        WriteInteger(expected);
        WriteLine(" bytes arrived");
        Free(data);
        return;
    }

    let elapsed = GetTime() - started;
    let error = WriteFile(file, data + header_end as usize, body_length);
    Free(data);

    if error != FILE_OK {
        WriteLine(FileErrorMessage(error));
        return;
    }

    Write("saved ");
    WriteInteger(body_length);
    Write(" bytes to ");
    Write(file);
    Write(" in ");
    WriteInteger(elapsed / 1000);
    WriteCharacter('.');
    WriteInteger(elapsed / 100 % 10);
    Write(" s");

    if elapsed >= 100 {
        Write(", ");
        WriteInteger(body_length / elapsed);
        Write(" KB/s");
    }

    WriteCharacter('\n');
}

fn CommandGet(arguments: *i8) {
    let rest = ParseArgument(arguments, &mut get_url[0], 256);

    if rest == null || AtEnd(rest) || ParseArgument(rest, &mut get_path[0], 128) == null {
        WriteLine("usage: get <url> <file>");
        return;
    }

    if TextStartsWith(&get_url[0], "https://") != null {
        WriteLine("https is not supported, use http");
        return;
    }

    let mut port: u32 = 80;
    let path = ParseURL(&get_url[0], &mut port);

    if path == null {
        WriteLine("usage: get http://host[:port]/path <file>");
        return;
    }

    Download(path, port, &get_path[0]);
}
