#[include "src/UART.zir" : *]

const CLK_FREQ: u32 = 81000000;

const UART_DATA: u32 = 0xFFFF;
const UART_STATUS: u32 = 0xFFFC;
const UART_DIVISOR: u32 = 0xFFF8;

const BUTTON: u32 = 0xFFF4;
const WS2812: u32 = 0xFFE0;
const LEDS: u32 = 0xFFF0;

const MS_COUNTER: u32 = 0xFFEC;
const CYCLE_COUNTER: u32 = 0xFFE8;
const INSTRUCTION_COUNTER: u32 = 0xFFE4;
const TIMER_COMPARE: u32 = 0xFFDC;
const IPI_SEND: u32 = 0xFFA8;
const IPI_CLEAR: u32 = 0xFFA4;
const CORE_CONTROL: u32 = 0xFFA0;
const SPINLOCK_BASE: u32 = 0xFF80;

const MAX_CORES: u32 = 8;

static mut console_uart: UARTPort;

fn InitializeUARTs() {
    console_uart = MakeUARTPort(UART_DATA, UART_STATUS, UART_DIVISOR);
}

fn SetBaudRate(baud: u32) {
    UARTSetBaudRate(&console_uart, baud);
}

fn SetLEDs(leds: i8) {
    volatile_write(LEDS as *mut i8, leds);
}

fn SetWS2812(_r: u8, _g: u8, _b: u8, brightness: u8) {
    let (mut r, mut g, mut b) = (_r as u32, _g as u32, _b as u32);

    if brightness < 255 {
        r = (r * brightness as u32) / 255;
        g = (g * brightness as u32) / 255;
        b = (b * brightness as u32) / 255;
    }

    volatile_write(WS2812 as *mut u32, (g << 16) | (r << 8) | b);
}

fn ButtonPressed() -> bool {
    (volatile_read(BUTTON as *u32) & 1) != 0
}

fn GetTime() -> u32 {
    volatile_read(MS_COUNTER as *u32)
}

fn GetCycles() -> u32 {
    volatile_read(CYCLE_COUNTER as *u32)
}

fn GetInstructions() -> u32 {
    volatile_read(INSTRUCTION_COUNTER as *u32)
}

fn SetTimer(cycles: u32) {
    volatile_write(TIMER_COMPARE as *mut u32, cycles);
}

fn CoreCount() -> u32 {
    let count = volatile_read(CORE_CONTROL as *u32);
    if count == 0 { 1 } else if count > MAX_CORES { MAX_CORES } else { count }
}

fn SendInterrupt(cores: u32) {
    volatile_write(IPI_SEND as *mut u32, cores);
}

fn ClearInterrupt() {
    volatile_write(IPI_CLEAR as *mut u32, 0);
}

fn TryAcquireSpinlock(index: u32) -> bool {
    volatile_read((SPINLOCK_BASE + index * 4) as *u32) != 0
}

fn ReleaseSpinlock(index: u32) {
    volatile_write((SPINLOCK_BASE + index * 4) as *mut u32, 0);
}
