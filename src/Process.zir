#[include "src/Devices.zir", "src/Trap.zir", "src/Memory.zir", "src/Paging.zir", "src/Handles.zir" : *]

type ProcessEntry = fn(u32);

const TICK_RATE: u32 = 100;
const MILLISECONDS_PER_TICK: u32 = 1000 / TICK_RATE;

const MAX_PROCESSES: u32 = 32;
const NO_PROCESS: u32 = 0xFFFFFFFF;
const NO_CORE: u32 = 0xFFFFFFFF;
const FIRST_PROCESS: u32 = MAX_CORES;
const KERNEL_LOCK: u32 = 0;

const STACK_SIZE: u32 = 1024;
const BRAM_STACKS: u32 = 12;
const STACKS_END: u32 = 0x00004000;
const STACKS_START: u32 = STACKS_END - BRAM_STACKS * STACK_SIZE;
const STACK_CANARY: u32 = 0x5AFE57AC;
const KERNEL_STACK_SIZE: u32 = 8192;
const THREAD_STACK_SIZE: u32 = 64 * 1024;
const THREAD_STACK_LIMIT: u32 = 4 * 1024 * 1024;

const STATUS_PREVIOUS_ENABLE: u32 = 2;
const STATUS_PREVIOUS_USER: u32 = 4;

const FUTEX_WOKEN: u32 = 0;
const FUTEX_TIMED_OUT: u32 = 1;
const FUTEX_MISMATCH: u32 = 2;

struct Frame {
    pub epc: u32,
    pub ra: u32, pub sp: u32, pub gp: u32, pub tp: u32, pub fp: u32,
    pub s1: u32, pub s2: u32, pub s3: u32, pub s4: u32, pub s5: u32, pub s6: u32, pub s7: u32, pub s8: u32, pub s9: u32, pub s10: u32, pub s11: u32,
    pub t0: u32, pub t1: u32, pub t2: u32, pub t3: u32, pub t4: u32, pub t5: u32, pub t6: u32,
    pub a0: u32, pub a1: u32, pub a2: u32, pub a3: u32, pub a4: u32, pub a5: u32, pub a6: u32, pub a7: u32,
    pub status: u32
}

enum ProcessState: u32 {
    Free, Ready, Sleeping, Waiting, Joining, Crashed, Loading, Exiting, Blocked
}

struct Process {
    pub state: ProcessState,
    pub frame: *mut Frame,
    pub wake_tick: u32,
    pub ticks: u32,
    pub name: *i8,
    pub label: [i8; 32],
    pub arguments: [i8; 128],
    pub image: *mut u8,
    pub stack_bottom: u32,
    pub stack_top: u32,
    pub child: u32,
    pub child_status: *mut i32,
    pub page_table: u32,
    pub heap_hint: u32,
    pub core: u32,
    pub last_core: u32,
    pub kill_pending: bool,
    pub group: u32,
    pub members: u32,
    pub ending: bool,
    pub exit_error: u32,
    pub exit_status: i32,
    pub exit_save: bool,
    pub user_stack: u32,
    pub futex_address: u32,
    pub futex_timed: bool
}

static mut processes: [Process; 32];
static mut current_processes: [u32; 8];
static mut kernel_holders: [bool; 8];
static mut kernel_waiters: [bool; 8];
static mut cores_online: [bool; 8];
static mut tlb_requests: [u32; 8];

fn CurrentProcess() -> u32 {
    current_processes[ReadCoreID() as usize]
}

fn SetCurrentProcess(id: u32) {
    current_processes[ReadCoreID() as usize] = id;
}

fn IsIdle(id: u32) -> bool {
    id < FIRST_PROCESS
}

fn GroupOf(id: u32) -> u32 {
    processes[id as usize].group
}

fn IsThread(id: u32) -> bool {
    processes[id as usize].group != id
}

fn ServiceShootdown(core: usize) {
    if volatile_read(&tlb_requests[core] as *u32) != 0 {
        FlushTLB(0);
        volatile_write(&mut tlb_requests[core] as *mut u32, 0);
    }
}

fn ShootdownTLB() {
    let core = ReadCoreID();
    let mut other: u32 = 0;

    while other < MAX_CORES {
        if other != core && cores_online[other as usize] {
            volatile_write(&mut tlb_requests[other as usize] as *mut u32, 1);
            SendInterrupt(1u32 << other);

            while volatile_read(&tlb_requests[other as usize] as *u32) != 0 {}
        }

        other += 1;
    }
}

fn OnlineCores() -> u32 {
    let mut count: u32 = 0;
    let mut core: u32 = 0;

    while core < MAX_CORES {
        if cores_online[core as usize] { count += 1; }
        core += 1;
    }

    count
}

fn AcquireKernel() {
    let core = ReadCoreID() as usize;
    if kernel_holders[core] { return; }
    kernel_waiters[core] = true;

    while !TryAcquireSpinlock(KERNEL_LOCK) {
        ServiceShootdown(core);
    }

    kernel_waiters[core] = false;
    kernel_holders[core] = true;
}

fn ReleaseKernel() {
    let core = ReadCoreID() as usize;
    if !kernel_holders[core] { return; }
    kernel_holders[core] = false;
    ReleaseSpinlock(KERNEL_LOCK);
}

fn OtherCoreWaiting() -> bool {
    let core = ReadCoreID();
    let mut other: u32 = 0;

    while other < MAX_CORES {
        if other != core && kernel_waiters[other as usize] {
            return true;
        }

        other += 1;
    }

    false
}

fn WakeIdleCores() {
    let core = ReadCoreID();
    let mut other: u32 = 0;

    while other < MAX_CORES {
        if other != core && current_processes[other as usize] == other {
            SendInterrupt(1u32 << other);
        }

        other += 1;
    }
}

@nomangle
fn PrepareReturn(frame: *Frame) {
    if (frame->status & STATUS_PREVIOUS_USER) != 0 {
        ReleaseKernel();
    }
}
static mut ticks: u32 = 0;

fn IsStackInBRAM(id: u32) -> bool {
    processes[id as usize].stack_bottom < STACKS_END
}

fn AllocateStack(id: u32, size: u32) -> u32 {
    if id < BRAM_STACKS && size == STACK_SIZE {
        STACKS_END - (id + 1) * STACK_SIZE
    } else {
        Allocate(size) as u32
    }
}

fn ReleaseStack(id: u32) {
    if !IsStackInBRAM(id) {
        Free(processes[id as usize].stack_bottom as *mut u8);
    }

    if processes[id as usize].image != null {
        Free(processes[id as usize].image);
        processes[id as usize].image = null;
    }
}

fn ReleaseThread(id: u32) {
    let leader = GroupOf(id);
    let process = &mut processes[id as usize];

    if process.user_stack != 0 {
        FreeUserMemory(id, process.user_stack);
        process.user_stack = 0;
    }

    ReleaseStack(id);
    process.page_table = 0;
    process.group = id;
    process.state = ProcessState::Free;
    processes[leader as usize].members -= 1;
}

fn ReleaseProcess(id: u32, save: bool) {
    if IsThread(id) {
        ReleaseThread(id);
        return;
    }

    CloseProcessFiles(id, save);
    FreeProcessAllocations(id);
    ReleaseStack(id);

    if processes[id as usize].page_table != 0 {
        processes[id as usize].page_table = 0;
        FlushTLB(1);
    }

    processes[id as usize].ending = false;
    processes[id as usize].members = 0;
    processes[id as usize].state = ProcessState::Free;
}

fn FinishGroup(leader: u32) {
    let (error, status, save) = (processes[leader as usize].exit_error, processes[leader as usize].exit_status, processes[leader as usize].exit_save);
    WakeJoiningProcesses(leader, error, status);
    ReleaseProcess(leader, save);
}

fn ReleaseMember(id: u32) {
    let leader = GroupOf(id);
    processes[id as usize].kill_pending = false;

    if id != leader {
        ReleaseThread(id);
    } else if processes[leader as usize].state != ProcessState::Exiting {
        processes[leader as usize].state = ProcessState::Exiting;
        processes[leader as usize].members -= 1;
    }

    if processes[leader as usize].ending && processes[leader as usize].members == 0 {
        FinishGroup(leader);
    }
}

fn RemoveMember(id: u32) {
    let process = &mut processes[id as usize];

    if process.kill_pending {
        return;
    }

    if id != CurrentProcess() && process.core != NO_CORE {
        process.kill_pending = true;
        SendInterrupt(1u32 << process.core);
    } else {
        ReleaseMember(id);
    }
}

fn EndGroup(id: u32, error: u32, status: i32, save: bool) {
    let leader = GroupOf(id);
    let group = &mut processes[leader as usize];

    if !group.ending {
        group.ending = true;
        group.exit_error = error;
        group.exit_status = status;
        group.exit_save = save;
    }

    let mut member = FIRST_PROCESS;

    while member < MAX_PROCESSES {
        if member != leader && processes[member as usize].state != ProcessState::Free && processes[member as usize].group == leader {
            RemoveMember(member);
        }

        member += 1;
    }

    if processes[leader as usize].state != ProcessState::Exiting {
        RemoveMember(leader);
    }
}

fn ActivateProcess(id: u32) {
    let process = &mut processes[id as usize];
    let core = ReadCoreID();
    process.core = core;

    if process.last_core != core {
        process.last_core = core;
        FlushTLB(1);
    }

    if process.page_table != 0 {
        SetAddressSpace(process.page_table | PTBASE_VALID, process.group);
    } else {
        SetAddressSpace(0, process.group);
    }
}

fn IsUserProcess(id: u32) -> bool {
    processes[id as usize].page_table != 0
}

fn AllocateUserMemory(id: u32, size: u32) -> u32 {
    let leader = GroupOf(id);
    let process = &mut processes[leader as usize];

    if process.page_table == 0 {
        return AllocateForProcess(size, leader) as u32;
    }

    if size == 0 || size > USER_HEAP_END - USER_HEAP_START {
        return 0;
    }

    let pages = (size + PAGE_MASK) / PAGE_SIZE;
    let address = FindFreeRange(process.page_table, process.heap_hint, pages);

    if address == 0 || !MapRange(leader, process.page_table, address, size, PTE_WRITE) {
        return 0;
    }

    process.heap_hint = address + (pages + 1) * PAGE_SIZE;
    address
}

fn FreeUserMemory(id: u32, address: u32) -> bool {
    let leader = GroupOf(id);
    let root = processes[leader as usize].page_table;

    if root == 0 {
        return FreeForProcess(address as *mut u8, leader);
    }

    let pages = AllocationPages(root, address);

    if pages == 0 {
        return false;
    }

    UnmapPages(leader, root, address, pages);

    if processes[leader as usize].members > 1 {
        ShootdownTLB();
    }

    true
}

fn CreateThread(entry: u32, argument: u32, requested: u32) -> u32 {
    let current = CurrentProcess();
    let leader = GroupOf(current);

    if !IsUserProcess(current) || processes[leader as usize].ending || requested > THREAD_STACK_LIMIT {
        return NO_PROCESS;
    }

    let size = if requested == 0 { THREAD_STACK_SIZE } else { (requested + PAGE_MASK) & !PAGE_MASK };
    let stack = AllocateUserMemory(current, size);

    if stack == 0 {
        return NO_PROCESS;
    }

    let id = SpawnWithStack(processes[leader as usize].name, entry as *void as ProcessEntry, argument, KERNEL_STACK_SIZE);

    if id == NO_PROCESS {
        FreeUserMemory(current, stack);
        return NO_PROCESS;
    }

    let process = &mut processes[id as usize];
    process.group = leader;
    process.members = 0;
    process.page_table = processes[leader as usize].page_table;
    process.user_stack = stack;
    process.frame->ra = 0;
    process.frame->sp = stack + size;
    process.frame->status = STATUS_PREVIOUS_ENABLE | STATUS_PREVIOUS_USER;
    processes[leader as usize].members += 1;
    id
}

fn WaitOnAddress(frame: *mut Frame, address: u32, expected: u32, milliseconds: u32) -> bool {
    if volatile_read(address as *u32) != expected {
        frame->a0 = FUTEX_MISMATCH;
        return false;
    }

    let process = &mut processes[CurrentProcess() as usize];
    process.futex_address = address;
    process.futex_timed = milliseconds != 0xFFFFFFFF;

    if process.futex_timed {
        process.wake_tick = ticks + (milliseconds + MILLISECONDS_PER_TICK - 1) / MILLISECONDS_PER_TICK;
    }

    frame->a0 = FUTEX_TIMED_OUT;
    process.state = ProcessState::Blocked;
    true
}

fn WakeAddress(address: u32, count: u32) -> u32 {
    let leader = GroupOf(CurrentProcess());
    let mut woken: u32 = 0;
    let mut id = FIRST_PROCESS;

    while id < MAX_PROCESSES && woken < count {
        let process = &mut processes[id as usize];

        if process.state == ProcessState::Blocked && process.group == leader && process.futex_address == address {
            process.frame->a0 = FUTEX_WOKEN;
            process.state = ProcessState::Ready;
            woken += 1;
        }

        id += 1;
    }

    if woken != 0 {
        WakeIdleCores();
    }

    woken
}

fn SetStack(id: u32, bottom: u32, size: u32) {
    let process = &mut processes[id as usize];
    process.stack_bottom = bottom;
    process.stack_top = bottom + size;
    *(bottom as *mut u32) = STACK_CANARY;
}

fn InitializeProcesses() {
    for i in 0..MAX_PROCESSES {
        processes[i as usize].core = NO_CORE;
        processes[i as usize].last_core = NO_CORE;
    }

    for i in 0..MAX_PROCESSES {
        processes[i as usize].group = i;
    }

    cores_online[0] = true;
    SetCurrentProcess(0);
    processes[0].state = ProcessState::Ready;
    processes[0].members = 1;
    processes[0].name = "idle";
    processes[0].core = 0;
    processes[0].last_core = 0;
    SetStack(0, AllocateStack(0, STACK_SIZE), STACK_SIZE);
}

fn InitializeIdle(core: u32, name: *i8, stack: u32, size: u32) {
    let process = &mut processes[core as usize];
    process.state = ProcessState::Ready;
    process.name = name;
    process.core = core;
    process.last_core = core;
    process.page_table = 0;
    process.group = core;
    process.members = 1;
    SetStack(core, stack, size);
}

fn Spawn(name: *i8, entry: ProcessEntry, argument: u32) -> u32 {
    SpawnWithStack(name, entry, argument, STACK_SIZE)
}

fn SpawnWithStack(name: *i8, entry: ProcessEntry, argument: u32, mut stack_size: u32) -> u32 {
    if stack_size < size_of<Frame>() as u32 + 8 || stack_size > 0xFFFFFFF8 {
        return NO_PROCESS;
    }

    stack_size = (stack_size + 7) & !7u32;
    let interrupts = DisableInterrupts();
    let mut id = FIRST_PROCESS;

    while id < MAX_PROCESSES && processes[id as usize].state != ProcessState::Free && processes[id as usize].state != ProcessState::Crashed {
        id += 1;
    }

    if id == MAX_PROCESSES {
        RestoreInterrupts(interrupts);
        return NO_PROCESS;
    }

    if processes[id as usize].state == ProcessState::Crashed {
        ReleaseProcess(id, false);
    }

    let stack = AllocateStack(id, stack_size);

    if stack == 0 {
        RestoreInterrupts(interrupts);
        return NO_PROCESS;
    }

    SetStack(id, stack, stack_size);
    let frame = (stack + stack_size - size_of<Frame>() as u32) as *mut Frame;
    let words = frame as *mut u32;

    for i in 0..size_of<Frame>() / 4 {
        words[i] = 0;
    }

    frame->epc = entry as *void as u32;
    frame->ra = ExitProcess as *void as u32;
    frame->sp = stack + stack_size;
    frame->a0 = argument;
    frame->status = STATUS_PREVIOUS_ENABLE;

    let process = &mut processes[id as usize];
    process.frame = frame;
    process.ticks = 0;
    process.name = name;
    process.image = null;
    process.child = NO_PROCESS;
    process.child_status = null;
    process.page_table = 0;
    process.heap_hint = USER_HEAP_START;
    process.core = NO_CORE;
    process.last_core = NO_CORE;
    process.kill_pending = false;
    process.group = id;
    process.members = 1;
    process.ending = false;
    process.user_stack = 0;
    process.futex_timed = false;
    process.state = ProcessState::Ready;
    WakeIdleCores();
    RestoreInterrupts(interrupts);
    id
}

fn SpawnUser(name: *i8, arguments: *i8, entry: u32) -> u32 {
    let interrupts = DisableInterrupts();
    let id = SpawnWithStack(name, entry as *void as ProcessEntry, 0, KERNEL_STACK_SIZE);

    if id != NO_PROCESS {
        let process = &mut processes[id as usize];
        let mut i: usize = 0;

        while i < 31 && name[i] != '\0' {
            process.label[i] = name[i];
            i += 1;
        }

        process.label[i] = '\0';
        process.name = &process.label[0] as *i8;
        let mut j: usize = 0;

        if arguments != null {
            while j < 127 && arguments[j] != '\0' {
                process.arguments[j] = arguments[j];
                j += 1;
            }
        }

        process.arguments[j] = '\0';
        process.frame->ra = 0;
        process.frame->sp = USER_STACK_TOP;
        process.frame->status = STATUS_PREVIOUS_ENABLE | STATUS_PREVIOUS_USER;
        process.state = ProcessState::Loading;
    }

    RestoreInterrupts(interrupts);
    id
}

fn GetCommandLine(buffer: *mut i8, capacity: usize) -> usize {
    if buffer == null || capacity == 0 {
        return 0;
    }

    let source = &processes[GroupOf(CurrentProcess()) as usize].arguments[0] as *i8;
    let mut i: usize = 0;

    while i + 1 < capacity && source[i] != '\0' {
        buffer[i] = source[i];
        i += 1;
    }

    buffer[i] = '\0';
    i
}

fn WakeJoiningProcesses(child: u32, error: u32, status: i32) {
    let mut id: u32 = 1;

    while id < MAX_PROCESSES {
        let process = &mut processes[id as usize];

        if process.state == ProcessState::Joining && process.child == child {
            if error == FILE_OK && process.child_status != null {
                WriteProcessWord(process.page_table, process.child_status as u32, status as u32);
            }

            process.frame->a0 = error;
            process.child = NO_PROCESS;
            process.child_status = null;
            process.state = ProcessState::Ready;
        }

        id += 1;
    }
}

fn ExitProcess() {
    DisableInterrupts();
    EndGroup(CurrentProcess(), FILE_OK, 0, true);
    Yield();
}

fn ForegroundProcesses() -> u32 {
    let mut foreground: u32 = 0;
    let mut id: u32 = 1;

    while id < MAX_PROCESSES {
        let process = &processes[id as usize];

        if process.state == ProcessState::Joining && process.child < MAX_PROCESSES && IsUserProcess(process.child) {
            foreground |= 1u32 << process.child;
        }

        id += 1;
    }

    foreground
}

fn Kill(id: u32) -> bool {
    if id >= MAX_PROCESSES || IsIdle(id) || GroupOf(id) == GroupOf(CurrentProcess()) {
        return false;
    }

    let interrupts = DisableInterrupts();
    let killed = processes[id as usize].state != ProcessState::Free;

    if killed {
        EndGroup(id, FILE_KILLED, 0, false);
    }

    RestoreInterrupts(interrupts);
    killed
}

fn Sleep(milliseconds: u32) {
    let interrupts = DisableInterrupts();
    let process = &mut processes[CurrentProcess() as usize];
    process.wake_tick = ticks + (milliseconds + MILLISECONDS_PER_TICK - 1) / MILLISECONDS_PER_TICK;
    process.state = ProcessState::Sleeping;
    Yield();
    RestoreInterrupts(interrupts);
}

fn WaitForInput() {
    processes[CurrentProcess() as usize].state = ProcessState::Waiting;
    Yield();
}

fn WakeSleepingProcesses() {
    let mut id: u32 = 1;

    while id < MAX_PROCESSES {
        let process = &mut processes[id as usize];

        if (process.state == ProcessState::Sleeping || (process.state == ProcessState::Blocked && process.futex_timed)) && ((ticks - process.wake_tick) as i32) >= 0 {
            process.state = ProcessState::Ready;
            WakeIdleCores();
        }

        id += 1;
    }
}

fn WakeWaitingProcesses() -> u32 {
    let mut woken = NO_PROCESS;
    let mut id: u32 = 1;

    while id < MAX_PROCESSES {
        let process = &mut processes[id as usize];

        if process.state == ProcessState::Waiting {
            process.state = ProcessState::Ready;

            if woken == NO_PROCESS {
                woken = id;
            }
        }

        id += 1;
    }

    woken
}

fn SaveContext(frame: *mut Frame) {
    let process = &mut processes[CurrentProcess() as usize];
    process.frame = frame;
    process.core = NO_CORE;

    if process.state != ProcessState::Free && process.state != ProcessState::Crashed && *(process.stack_bottom as *u32) != STACK_CANARY {
        process.state = ProcessState::Crashed;
        WakeJoiningProcesses(CurrentProcess(), FILE_CRASHED, 0);
    }
}

fn SwitchTo(frame: *mut Frame, id: u32) -> *mut Frame {
    SaveContext(frame);
    SetCurrentProcess(id);
    ActivateProcess(id);
    processes[id as usize].frame
}

@nomangle
fn Schedule(frame: *mut Frame) -> *mut Frame {
    SaveContext(frame);
    let mut id = CurrentProcess();
    let yield_kernel = OtherCoreWaiting();
    let mut i: u32 = 0;

    while i < MAX_PROCESSES {
        id = (id + 1) % MAX_PROCESSES;
        let process = &processes[id as usize];

        if !IsIdle(id) && process.state == ProcessState::Ready && process.core == NO_CORE && (!yield_kernel || IsUserProcess(id)) {
            SetCurrentProcess(id);
            ActivateProcess(id);
            return process.frame;
        }

        i += 1;
    }

    let idle = ReadCoreID();
    SetCurrentProcess(idle);
    ActivateProcess(idle);
    processes[idle as usize].frame
}
