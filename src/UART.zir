#[include "src/Devices.zir" : *]

const UART_RX_READY: u32 = 1;
const UART_TX_BUSY: u32 = 2;

struct UARTPort {
    pub data: u32,
    pub status: u32,
    pub divisor: u32
}

fn MakeUARTPort(data: u32, status: u32, divisor: u32) -> UARTPort {
    UARTPort { data: data, status: status, divisor: divisor }
}

fn UARTSetBaudRate(port: *UARTPort, baud: u32) {
    *(port->divisor as *mut u32) = CLK_FREQ / baud;
}

fn UARTHasByte(port: *UARTPort) -> bool {
    (*(port->status as *u32) & UART_RX_READY) != 0
}

fn UARTRead(port: *UARTPort) -> u8 {
    *(port->data as *u8)
}

fn UARTWrite(port: *UARTPort, value: u8) {
    while (*(port->status as *u32) & UART_TX_BUSY) != 0 {}
    *(port->data as *mut u8) = value;
}
