const SPI_SELECT: u32 = 1;
const SPI_BUSY: u32 = 2;
const SPI_CPOL: u32 = 4;
const SPI_CPHA: u32 = 8;
const SPI_LSB_FIRST: u32 = 16;
const SPI_MODE_MASK: u32 = SPI_CPOL | SPI_CPHA | SPI_LSB_FIRST;

const SPI_MODE_0: u32 = 0;
const SPI_MODE_1: u32 = SPI_CPHA;
const SPI_MODE_2: u32 = SPI_CPOL;
const SPI_MODE_3: u32 = SPI_CPOL | SPI_CPHA;

struct SPIPort {
    pub data: u32,
    pub control: u32,
    pub divisor: u32,
    pub mode: u32
}

fn MakeSPIPort(base: u32) -> SPIPort {
    SPIPort { data: base, control: base - 4, divisor: base - 8, mode: SPI_MODE_0 }
}

fn SPIConfigure(port: *mut SPIPort, mode: u32, divisor: u32) {
    port->mode = mode & SPI_MODE_MASK;
    *(port->control as *mut u32) = port->mode;
    *(port->divisor as *mut u32) = divisor;
}

fn SPISetDivisor(port: *SPIPort, divisor: u32) {
    *(port->divisor as *mut u32) = divisor;
}

fn SPISelect(port: *SPIPort) {
    *(port->control as *mut u32) = port->mode | SPI_SELECT;
}

fn SPIDeselect(port: *SPIPort) {
    *(port->control as *mut u32) = port->mode;
}

fn SPITransfer(port: *SPIPort, value: u32) -> u32 {
    *(port->data as *mut u32) = value;
    while (*(port->control as *u32) & SPI_BUSY) != 0 {}
    *(port->data as *u32) & 0xFF
}
