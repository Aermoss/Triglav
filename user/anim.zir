#[include "Common/System.zir" : *]

const SYSTEM_SET_ANIMATION: u32 = 35;
const KEEP_BRIGHTNESS: u32 = 0xFFFFFFFF;

fn SetAnimation(mode: u32, brightness: u32) -> bool {
    let mut result: u32 = 0;

    volatile asm : a7(SYSTEM_SET_ANIMATION), a0(mode), a1(brightness) -> {
        ecall
    } -> a0(result) : memory;

    result == FILE_OK
}

fn Main(args: &mut Vector<String>) -> i32 {
    if args.Length() != 2 && args.Length() != 3 {
        WriteLine("Usage: anim <mode> [brightness]");
        return 1;
    }

    let mode = args[1].ToUnsignedInteger();
    let brightness = if args.Length() == 3 { args[2].ToUnsignedInteger() } else { Option<u32>::Some(KEEP_BRIGHTNESS) };

    if mode.IsNone() || brightness.IsNone() || (brightness.Unwrap() > 255 && brightness.Unwrap() != KEEP_BRIGHTNESS) || !SetAnimation(mode.Unwrap(), brightness.Unwrap()) {
        WriteLine("Usage: anim <mode> [brightness]");
        return 1;
    }

    0
}
