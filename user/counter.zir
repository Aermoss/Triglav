#[include "std/io", "std/str", "std/vec" : *]

const SYSTEM_SLEEP: u32 = 10;
const SYSTEM_SET_LEDS: u32 = 36;

fn Sleep(milliseconds: u32) {
    volatile asm : a7(SYSTEM_SLEEP), a0(milliseconds) -> {
        ecall
    } : memory;
}

fn SetLEDs(value: u32) {
    volatile asm : a7(SYSTEM_SET_LEDS), a0(value) -> {
        ecall
    } : memory;
}

const COUNTER_INTERVAL: u32 = 10;

fn Main(args: &mut Vector<String>) -> i32 {
    let mut count: u32 = 0;

    loop {
        SetLEDs(((count & 0x3F) ^ 0x3F));
        count += 1;
        Sleep(COUNTER_INTERVAL);
    }

    0
}
